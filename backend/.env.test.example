# Copie para .env.test (cp .env.test.example .env.test). Nunca commite o .env.test.
# Lido só por `pnpm test:integration`. Os testes de integração se recusam a rodar se o
# banco não for "soprei_test" ou se o Redis não for o índice 15.

NODE_ENV=test
LOG_LEVEL=silent

# Banco de testes (nunca o de desenvolvimento)
DATABASE_URL=postgresql://soprei:<senha>@localhost:5432/soprei_test?schema=public

# Redis de testes: índice 15
REDIS_URL=redis://localhost:6379/15

# Autenticação (spec 007). Os testes de integração NÃO dependem destas variáveis (usam um JWT_SECRET
# descartável próprio e cada teste monta o serviço de sessões com prefixo único no Redis /15). Defina
# só para exercitar o servidor ou `pnpm auth:cli` à mão contra o banco de testes. A antiga ADMIN_API_KEY
# foi removida. Nunca ponha aqui o segredo do seu .env de desenvolvimento.
# JWT_SECRET=<valor-de-teste-com-no-minimo-32-caracteres>
# JWT_ISSUER=soprei
# JWT_AUDIENCE=soprei-api
# AUTH_ACCESS_TTL_SECONDS=900
# AUTH_REFRESH_TTL_SECONDS=604800
# AUTH_SESSION_MAX_SECONDS=2592000
# AUTH_CLOCK_TOLERANCE_SECONDS=5
# AUTH_LOGIN_MAX_FAILURES=5
# AUTH_LOGIN_LOCK_SECONDS=900
# AUTH_REDIS_TIMEOUT_MS=500
# AUTH_REDIS_PREFIX=soprei:auth:
# RATE_LIMIT_LOGIN_MAX=10
# RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
# RATE_LIMIT_REFRESH_MAX=60
# RATE_LIMIT_REFRESH_WINDOW_SECONDS=900

# Token de /metrics (opcional; mínimo de 32 caracteres se informado). Os testes de rota usam
# tokens próprios, gerados por eles; deixe em branco, a menos que queira exercitar /metrics à mão.
# METRICS_TOKEN=

# Atendimento (spec 010): os testes não dependem destas variáveis (usam os defaults: provedor
# "mock", 15 s de timeout do LLM e 60 s de "em andamento"); os testes de timeout criam o serviço
# com prazos próprios. Defina só se quiser exercitar o servidor à mão contra o banco de testes.
# LLM_PROVIDER=mock
# LLM_TIMEOUT_MS=15000
# Provedor real (spec 014): os testes NUNCA chamam a API da Anthropic; usam um servidor falso local
# e `ANTHROPIC_BASE_URL` apontado para ele. Não ponha chave real aqui.
# ANTHROPIC_API_KEY=<chave-de-mentira-com-20-ou-mais-caracteres>
# ATTENDANCE_IN_FLIGHT_TIMEOUT_MS=60000

# Rate limiting (spec 005): os testes não dependem destas variáveis; cada teste monta o servidor com
# limites e namespace Redis (único, no índice 15) próprios. Defina só para exercitar o servidor à mão
# contra o banco de testes. Atrás de túnel ou proxy, liste o proxy em TRUST_PROXY, ex.: 127.0.0.1,::1 (ver .env.example); "true" nunca em produção.
# RATE_LIMIT_ENABLED=true
# RATE_LIMIT_PUBLIC_MAX=100
# RATE_LIMIT_PUBLIC_WINDOW_SECONDS=900
# RATE_LIMIT_ADMIN_MAX=600
# RATE_LIMIT_ADMIN_WINDOW_SECONDS=60
# RATE_LIMIT_WEBHOOK_MAX=600
# RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60
# RATE_LIMIT_REDIS_TIMEOUT_MS=250
# TRUST_PROXY=false

# Canal WhatsApp (spec 011): os testes não dependem destas variáveis (cada teste monta o servidor, a fila
# com prefixo único no Redis /15 e um servidor Graph falso local). Defina só para exercitar o servidor à mão
# contra o banco de testes. Com WHATSAPP_ENABLED=true, TRUST_PROXY precisa estar definido (ver .env.example).
# WHATSAPP_ENABLED=false
# WHATSAPP_APP_SECRET=
# WHATSAPP_VERIFY_TOKEN=
# WHATSAPP_ACCESS_TOKEN=
# Spec 015: os testes NÃO dependem destas variáveis (`loadIntegrationConfig()` injeta chaves e app id
# descartáveis). Defina só para exercitar o servidor à mão. Nunca ponha aqui chave do seu .env.
# WHATSAPP_APP_ID=
# CHANNEL_CREDENTIALS_KEYS=
# CHANNEL_CREDENTIALS_ACTIVE_KEY_ID=
# WHATSAPP_API_BASE_URL=https://graph.facebook.com
# WHATSAPP_GRAPH_API_VERSION=v26.0
# WHATSAPP_SEND_TIMEOUT_MS=10000
# QUEUE_ATTEMPTS=5
# QUEUE_BACKOFF_MS=10000
# QUEUE_KEEP_COMPLETED_SECONDS=3600
# QUEUE_KEEP_FAILED_SECONDS=86400
# CHANNEL_BATCH_WINDOW_MS=5000
# CHANNEL_BATCH_MAX_WAIT_MS=20000
# CHANNEL_BATCH_MAX_MESSAGES=10
# CHANNEL_BATCH_MAX_CHARS=8000
ACCOUNTS_ENABLED=false
