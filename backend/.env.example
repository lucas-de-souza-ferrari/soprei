# Copie para .env (cp .env.example .env) e ajuste. Nunca commite o .env.
# Todas as variáveis são validadas no boot em src/infrastructure/config/.

# Ambiente de execução: development | test | production
NODE_ENV=development

# Endereço e porta em que o servidor HTTP escuta
HOST=0.0.0.0
PORT=3000

# Nível de log do Pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL nativo (obrigatória). Role "soprei" e banco "soprei": ver "Ambiente local" no AGENTS.md.
# Troque <senha> pela senha escolhida ao criar o role (com caracteres especiais, use URL-encode).
DATABASE_URL=postgresql://soprei:<senha>@localhost:5432/soprei?schema=public

# Redis nativo (obrigatória). Índice 0 para desenvolvimento; os testes usam o 15 (ver .env.test.example).
REDIS_URL=redis://localhost:6379/0

# Pool de conexões do PostgreSQL (opcionais; os valores abaixo são os defaults)
# Máximo de conexões abertas (1 a 200). Com o canal ligado precisa ser >= QUEUE_CONCURRENCY + 5
# (cada job ativo pode segurar uma conexão; o resto atende o HTTP e as tarefas periódicas).
DB_POOL_MAX=20
# Tempo para fechar uma conexão ociosa, em ms (1 a 3600000)
DB_POOL_IDLE_TIMEOUT_MS=30000
# Tempo máximo esperando uma conexão do pool, em ms (1 a 120000)
DB_POOL_CONNECTION_TIMEOUT_MS=5000
# Tempo máximo de uma query no servidor, em ms (1 a 600000)
DB_STATEMENT_TIMEOUT_MS=30000

# Autenticação (spec 007). Substitui a antiga ADMIN_API_KEY, que foi REMOVIDA: se ainda estiver no seu
# .env, deixou de ter efeito (pode apagar). As rotas /admin/* agora exigem um access token (login em
# POST /auth/login ou /auth/platform/login); o primeiro usuário nasce por `pnpm auth:cli` (ver docs/areas/autenticacao-e-papeis.md).
# Segredo do JWT (HS256): OBRIGATÓRIO em todos os ambientes, mínimo 32 caracteres, nunca em log.
# Para gerar: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Trocar o segredo derruba todos os access tokens (os refresh tokens continuam e geram novos).
# Descomente e preencha (sem valor padrão de propósito: um valor público de exemplo seria um segredo fraco).
# JWT_SECRET=
JWT_ISSUER=soprei
JWT_AUDIENCE=soprei-api
# Validade do access token, em segundos (60 a 3600).
AUTH_ACCESS_TTL_SECONDS=900
# Refresh token: prazo ocioso (renovado a cada rotação; 3600 a 2592000) e teto absoluto da sessão desde o
# login (precisa ser maior ou igual ao ocioso).
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_SESSION_MAX_SECONDS=2592000
# Tolerância de relógio na verificação do access token, em segundos (0 a 60).
AUTH_CLOCK_TOLERANCE_SECONDS=5
# Bloqueio por conta: depois de N falhas de senha em LOCK segundos, novas tentativas respondem 429
# (também para contas que não existem). N de 1 a 20; LOCK de 60 a 86400.
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCK_SECONDS=900
# Prazo de cada comando da conexão Redis das sessões, em ms (1 a 10000). Redis fora: as rotas de
# autenticação respondem 503 (fail-closed), nunca aceitam nem emitem token.
AUTH_REDIS_TIMEOUT_MS=500
AUTH_REDIS_PREFIX=soprei:auth:

# Token do endpoint GET /metrics (spec 004), enviado em "Authorization: Bearer <token>".
# Opcional. Sem ele, /metrics NÃO existe (responde 404), para não expor métricas por engano.
# Se informado, precisa ter no mínimo 32 caracteres; vazio vale como ausente.
# Para gerar: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# METRICS_TOKEN=

# Atendimento (spec 010). Todas opcionais; os valores abaixo são os defaults.
# Provedor de LLM por trás da interface LlmProvider: "mock" (determinístico, sem rede; padrão) ou
# "anthropic" (Claude, spec 014). Trocar de modelo é mudar esta variável, não código de negócio.
LLM_PROVIDER=mock
# Só com LLM_PROVIDER=anthropic (spec 014). A chave é um segredo: nunca commite, nunca cole em chat
# nem em log. Crie na Anthropic Console e DEFINA UM LIMITE DE GASTO MENSAL na conta antes de usar.
# ANTHROPIC_API_KEY=<sua-chave-da-anthropic>
# Opcional; https:// em produção. Existe para os testes (servidor falso); vazio usa a API oficial.
# ANTHROPIC_BASE_URL=
# O SDK também lê ANTHROPIC_CUSTOM_HEADERS do ambiente; o provedor o ignora de propósito.
# Modelo (padrão claude-haiku-5-5; formato ^[a-z0-9.-]{1,64}$).
# LLM_MODEL=claude-haiku-5-5
# Esforço de raciocínio: low (padrão), medium ou high. Mais esforço, mais latência e custo.
# LLM_EFFORT=low
# Teto de tokens por resposta (64 a 8192; padrão 1024). Conta também o pensamento adaptivo do modelo:
# com LLM_EFFORT medium ou high, suba o teto; senão a resposta é cortada (max_tokens -> resultado
# truncated) e o contato recebe o texto padrão. Resposta cortada nunca é enviada pela metade.
# LLM_MAX_OUTPUT_TOKENS=1024
# Repetições em 408/409/429/5xx e falha de rede (0 a 3; padrão 1), sempre dentro de LLM_TIMEOUT_MS.
# LLM_MAX_RETRIES=1
# Prazo máximo de uma chamada ao LLM, em ms (1 a 120000). Estourou: o contato recebe o texto padrão de falha.
LLM_TIMEOUT_MS=15000
# Ferramentas de agenda da IA (spec 028). Chave global, desligada por padrão (true/false literais): ligada, a
# IA consulta os horários livres por ferramenta (tool use) nos turnos com intenção de agenda e, nas empresas
# que ligaram "A IA pode solicitar, cancelar e remarcar" em Agenda > Configurar, também solicita, cancela e
# remarca horários do próprio contato (cotas no Redis). Só com LLM_PROVIDER=anthropic (o mock só roda roteiros
# de teste). Faça o passo zero E0 da spec 028 (teste manual com a chave real) antes de ligar. Cada chamada ao modelo reenvia o prompt (até
# 4 por turno), então só ligue com limite de gasto definido. Reinicie o backend depois de mudar.
SCHEDULE_AI_ENABLED=false
# Planos e assinaturas (spec 031). Chave global, desligada por padrão (true/false literais): desligada, NADA é
# cobrado, limitado nem medido e o sistema se comporta como antes. Ligada: cada conta ganha um teste gratuito, o
# limite de empresas, as cotas de respostas e de tokens por mês e os módulos Agenda e Estoque passam a valer.
# Os preços e as cotas ficam no catálogo do banco (migration), nunca aqui. O pagamento pela InfinitePay é a flag
# CHECKOUT_ENABLED (abaixo): sem ela ninguém consegue pagar, então NÃO ligue a cobrança no banco do dia a dia.
BILLING_ENABLED=false
# Gate do modo "o Soprei paga a Meta" (spec 031, D0): só ligue depois de confirmar a linha de crédito da Meta
# (E0). Exige BILLING_ENABLED=true. Padrão false: versões de preço desse modo são ignoradas.
SOPREI_PAYS_META_ENABLED=false
# Dias de carência depois do fim do período pago (IA e painel seguem com faixa de aviso), dias e cotas do teste
# gratuito (uma vez por conta, sem cartão). Spec 040 (D8): respostas do teste (1 a 1000, limitadas à cota do
# plano; padrão 100) e tokens do teste (proteção de custo, fora da tela; padrão 600000 = 100 x 6.000).
BILLING_GRACE_DAYS=5
BILLING_TRIAL_DAYS=7
BILLING_TRIAL_REPLIES=100
BILLING_TRIAL_TOKENS=600000
# Checkout da InfinitePay (spec 031, E3). Flag propria, desligada por padrao: ligada, a assinatura pode ser paga por
# link de pagamento (Pix ou cartao) e o webhook /webhooks/infinitepay/:orderId passa a existir. Exige BILLING_ENABLED=true.
# NAO existe sandbox na InfinitePay: o primeiro teste real e um link de R$ 1,00 feito pelo dono, com a API Key dele.
CHECKOUT_ENABLED=false
# API Key do Checkout (formato inchk_...), criada nas configuracoes do Checkout da InfinitePay e mostrada uma unica
# vez. Segredo: nunca em log, URL nem navegador. Obrigatoria com CHECKOUT_ENABLED=true (minimo 16 caracteres).
INFINITEPAY_API_KEY=
# InfiniteTag da conta de recebimento, SEM o cifrao. Obrigatoria com CHECKOUT_ENABLED=true.
INFINITEPAY_HANDLE=
# Base da API (padrao abaixo; http:// so fora de producao, existe para o servidor falso dos testes).
INFINITEPAY_API_BASE_URL=https://api.checkout.infinitepay.io
# Origem PUBLICA do backend, usada para montar a webhook_url (http(s)://host[:porta], sem caminho nem barra final;
# https:// em producao). A URL do webhook leva um token HMAC por pedido (derivado do JWT_SECRET). Atras de tunel, use o endereco do tunel e defina TRUST_PROXY explicitamente.
INFINITEPAY_WEBHOOK_BASE_URL=
# Prazo (ms) de cada chamada a InfinitePay.
BILLING_HTTP_TIMEOUT_MS=8000
# Unico host aceito para o link de pagamento devolvido pela InfinitePay (qualquer outro e recusado). O padrao e o do
# exemplo da documentacao; confirme no teste real e mude aqui se for outro.
INFINITEPAY_CHECKOUT_HOST=checkout.infinitepay.io
# LGPD: se true, o e-mail da conta vai ao provedor no link (pre-preenche o checkout). Padrao false; DECISAO DO DONO.
CHECKOUT_SEND_CUSTOMER_EMAIL=false
# Reconciliacao de pagamentos: timer proprio (minutos). 0 desliga so ela; nao depende do expurgo de contas.
BILLING_RECONCILE_INTERVAL_MINUTES=10
# Avisos de cobranca por e-mail ao titular (vencimento, carencia, cota a 80% e 100%, pagamento recebido): tarefa
# propria (minutos). 0 desliga so ela. Exige BILLING_ENABLED e CHECKOUT_ENABLED; usa o mesmo SMTP das contas.
BILLING_NOTICE_INTERVAL_MINUTES=60
# Com CHECKOUT_ENABLED=true, TRUST_PROXY precisa estar definido explicitamente (mesmo false): o webhook publico
# de pagamento divide a cota do perfil webhook por IP.
# Uma mensagem do contato sem resposta há mais que isto (ms, 1 a 3600000) deixa de estar "em andamento":
# a retentativa com o mesmo externalId completa o fluxo em vez de receber 409.
ATTENDANCE_IN_FLIGHT_TIMEOUT_MS=60000

# Rate limiting (spec 005). Todas opcionais; os valores abaixo são os defaults.
# Limites por perfil e por IP, guardados no Redis (valem entre várias instâncias). Estourou: 429.
# Liga/desliga ("true" ou "false" literais). "false" é rejeitado com NODE_ENV=production.
RATE_LIMIT_ENABLED=true
# Cada perfil: máximo de requisições (1 a 1000000) por janela em segundos (1 a 86400).
# public: rede de segurança, vale para toda rota sem perfil declarado
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=900
# admin: rotas /admin/*
RATE_LIMIT_ADMIN_MAX=600
RATE_LIMIT_ADMIN_WINDOW_SECONDS=60
# webhook: webhook do canal de mensagens (spec 011). Folgado de propósito: 429 faz a Meta retentar.
RATE_LIMIT_WEBHOOK_MAX=600
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60
# login: /auth/login e /auth/platform/login (spec 007). refresh: /auth/refresh e /auth/logout. Esses dois
# perfis são FAIL-CLOSED: com o Redis do limiter fora, respondem 503 em vez de liberar.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_REFRESH_WINDOW_SECONDS=900
# contact: POST /contact/sales, o formulário de contato comercial (spec 040). FAIL-CLOSED, 5 por hora por IP;
# além disso há um teto fixo de 30 e-mails por dia (no código, sem variável).
RATE_LIMIT_CONTACT_MAX=5
RATE_LIMIT_CONTACT_WINDOW_SECONDS=3600
# Prazo de cada comando Redis do limiter, em ms (1 a 10000). Redis fora ou lento custa no máximo isto
# por requisição, que passa em fail-open (com log de erro e a métrica rate_limit_store_errors_total).
RATE_LIMIT_REDIS_TIMEOUT_MS=250
# De onde vem o IP de origem (a chave do limite). Padrão false: X-Forwarded-For é IGNORADO.
#   false                ignora X-Forwarded-For (o servidor recebe conexões direto de quem chama)
#   127.0.0.1,::1        lista de IPs/CIDRs dos proxies confiáveis (o peer que abre a conexão com o
#                        servidor). Túnel local (Cloudflare Tunnel, ngrok) na mesma máquina: 127.0.0.1,::1.
#                        nginx em outra máquina: o IP dela, ex.: 10.0.0.5 ou 10.0.0.0/8. O IP de origem é o
#                        último endereço do X-Forwarded-For que não está na lista.
#   true                 confia em TODA a cadeia: quem chama escolhe o IP que quiser e escapa do limite.
#                        Só para ambiente fechado; NUNCA em produção (a config recusa com NODE_ENV=production).
# Não existe valor inteiro ("1 proxy"): o Fastify não confia em contagem de saltos.
# ANTES de depender de um túnel ou proxy, confirme que ele ACRESCENTA o IP de origem ao
# X-Forwarded-For (e não repassa o cabeçalho que veio de quem chamou): senão quem chama forja o IP.
# COM TÚNEL OU PROXY, configure a lista: sem isso todos os chamadores (inclusive um atacante e a Meta)
# parecem um IP só e dividem a mesma cota.
TRUST_PROXY=false

# Canal WhatsApp (spec 011): webhook de entrada, fila e envio da resposta pela Cloud API da Meta.
# Opt-in: sem WHATSAPP_ENABLED=true as rotas GET/POST /webhooks/whatsapp NÃO existem (404).
# "true" ou "false" literais. Com "true", WHATSAPP_APP_SECRET, WHATSAPP_VERIFY_TOKEN, WHATSAPP_APP_ID, as chaves de cifra e TRUST_PROXY (acima) são obrigatórios;
# TRUST_PROXY precisa estar DEFINIDO explicitamente (mesmo "false"): atrás de túnel/proxy, liste-o
# (ex.: TRUST_PROXY=127.0.0.1,::1 com Cloudflare Tunnel/ngrok na mesma máquina).
WHATSAPP_ENABLED=false
# Segredo do app Meta (App Dashboard > Configurações > Básico; mínimo de 16 caracteres). Usado só para validar X-Hub-Signature-256.
# WHATSAPP_APP_SECRET=
# Token de verificação do webhook: escolhido por você (mínimo 16 caracteres) e digitado no painel da Meta.
# Usado só no handshake GET. Para gerar: node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
# WHATSAPP_VERIFY_TOKEN=
# Token global de TRANSIÇÃO (spec 015): só para empresas LEGACY (número gravado antes da 015 e sem conexão
# própria). Opcional (mínimo de 16 caracteres se informado). Cada empresa passa a ter o seu token, guardado
# cifrado (PUT /admin/companies/:companyId/channel). Quando nenhuma empresa estiver LEGACY, apague esta variável.
# WHATSAPP_ACCESS_TOKEN=
# ID do app Meta (spec 015; obrigatório com o canal ligado; só dígitos). Todo token de empresa precisa ter
# este app_id no debug_token, senão é recusado (o webhook só chega para o nosso app).
# WHATSAPP_APP_ID=
# config_id do Embedded Signup (spec 023; opcional; só dígitos; exige WHATSAPP_ENABLED=true): App Dashboard >
# Facebook Login for Business > Configurações. É um valor PÚBLICO (o site o recebe por GET .../channel/setup).
# Sem ele o botão "Conectar com a Meta" não aparece no site (o resto do canal segue).
# WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID=
# Formulário "Avançado (testes)" do site (spec 023): conectar digitando phoneNumberId, wabaId e token do nosso
# app (número de teste da Meta, antes da App Review). "true" ou "false" literais; padrão false e RECUSADO com
# NODE_ENV=production. Controla SÓ a seção "Avançado" da interface: o PUT /admin/companies/:companyId/channel com
# token digitado continua existindo como API para OWNER/ADMIN em qualquer ambiente, protegido pela prova de posse
# da spec 015 (token do nosso app, número na WABA).
# CHANNEL_MANUAL_CONNECT_ENABLED=false
# Coexistência (spec 039): conectar o número que SEGUE no aplicativo WhatsApp Business do celular e tratar o eco
# das mensagens que a equipe envia pelo celular (a IA pausa 12 h naquele contato). "true" ou "false" literais;
# padrão false. Exige WHATSAPP_ENABLED=true e um config_id (o do Embedded Signup acima serve, confirmado no E0).
# Depois de ligar e do primeiro eco gravado, NÃO volte o código para antes da spec 039 (docs/ops/deploy.md).
# Na Meta, assine o campo de webhook "smb_message_echoes" (não assine "history").
# WHATSAPP_COEXISTENCE_ENABLED=false
# config_id próprio da coexistência (spec 039; opcional; só dígitos; exige a variável acima). Vazio = usa o
# WHATSAPP_EMBEDDED_SIGNUP_CONFIG_ID. Só se a Meta exigir uma configuração separada.
# WHATSAPP_COEXISTENCE_CONFIG_ID=
# Chaves de cifra das credenciais das empresas (spec 015; obrigatórias com o canal ligado). Lista
# "keyId:<32 bytes em base64url>" separada por vírgula (keyId: letras, dígitos, "_" ou "-", até 16).
# Gerar uma chave: node -e "console.log(require('node:crypto').randomBytes(32).toString('base64url'))"
# Fica SÓ no ambiente do servidor (nunca no git nem no banco). Perder a chave = cada empresa refaz o PUT.
# Rotação: ponha a chave nova na lista, aponte ACTIVE_KEY_ID para ela e mantenha a antiga até todo texto
# ser regravado (um novo PUT da empresa já recifra com a chave ativa).
# CHANNEL_CREDENTIALS_KEYS=
# keyId da chave que cifra (precisa estar na lista acima).
# CHANNEL_CREDENTIALS_ACTIVE_KEY_ID=
# Opcionais; os valores abaixo são os defaults.
# URL base do Graph API (http:// só fora de produção; os testes apontam para um servidor falso local).
WHATSAPP_API_BASE_URL=https://graph.facebook.com
# Versão do Graph API (formato vNN.N). Padrão: a versão estável vigente quando a spec 011 foi implementada.
WHATSAPP_GRAPH_API_VERSION=v26.0
# Prazo de cada envio ao Graph API, em ms (1 a 120000).
WHATSAPP_SEND_TIMEOUT_MS=10000
# Fila de entrada (BullMQ sobre o Redis). Tentativas por job (1 a 20) e atraso inicial do backoff
# exponencial em ms (10 s, 20 s, 40 s, 80 s com os padrões). Com o canal ligado,
# QUEUE_BACKOFF_MS x (2^(QUEUE_ATTEMPTS - 1) - 1) precisa ser maior que ATTENDANCE_IN_FLIGHT_TIMEOUT_MS.
QUEUE_ATTEMPTS=5
QUEUE_BACKOFF_MS=10000
# Retenção MÍNIMA (s) de jobs concluídos e falhos no Redis (o job guarda o texto do contato e o contactRef).
# Não é um TTL: o BullMQ só apaga por idade quando OUTRO job termina e as chaves não expiram sozinhas, então
# sem tráfego o último job (texto e contactRef) pode ficar no Redis indefinidamente. Limpeza periódica ou TTL
# são pendência da spec 011, a resolver com a política de retenção/LGPD antes de dados reais.
QUEUE_KEEP_COMPLETED_SECONDS=3600
QUEUE_KEEP_FAILED_SECONDS=86400
# Jobs processados ao mesmo tempo pelo worker (1 a 100; spec 034). Cada resposta segura uma vaga durante a
# chamada ao modelo e o envio, então este é o número de contatos atendidos em paralelo. A ordem das mensagens
# de um contato vem do instante de recebimento no webhook, não da fila. 1 reproduz o comportamento antigo.
# Antes de subir, confira o limite de requisições da conta no provedor de IA e o DB_POOL_MAX.
QUEUE_CONCURRENCY=10
# Prazo global do desligamento gracioso, em ms (5000 a 300000; spec 034). Passou disso, o processo sai com
# código 1 e os jobs interrompidos voltam no próximo boot. Com o canal ligado precisa ser maior que a espera
# do worker: prazo do turno (LLM_TIMEOUT_MS, ou 30 s com SCHEDULE_AI_ENABLED) + WHATSAPP_SEND_TIMEOUT_MS + 5 s.
# Quem supervisiona o processo (systemd, contêiner) precisa esperar pelo menos este tempo antes de matar.
SHUTDOWN_TIMEOUT_MS=60000
# Agrupamento de mensagens rápidas do canal (spec 013): o sistema espera o contato parar de escrever e
# responde UMA vez às mensagens pendentes. Só valem com o canal habilitado; o simulador /admin não espera.
# Janela deslizante: cada mensagem nova reinicia a espera (0 a 60000 ms; 0 desliga a espera).
# Toda resposta passa a demorar pelo menos a janela, mais o tempo do LLM.
CHANNEL_BATCH_WINDOW_MS=5000
# Teto de espera, contado desde a mais antiga mensagem pendente (0 a 300000 ms; >= a janela).
CHANNEL_BATCH_MAX_WAIT_MS=20000
# Limites de uma resposta: mensagens (1 a 50) e caracteres somados (1 a 24000). O excedente vira o
# turno seguinte, sem nova espera; uma única mensagem maior que o limite de caracteres segue sozinha.
CHANNEL_BATCH_MAX_MESSAGES=10
CHANNEL_BATCH_MAX_CHARS=8000
# Retomada do atendimento (spec 035): a cada N minutos (0 a 1440) o sistema reagenda a resposta de
# quem ficou sem ela no canal (mensagem pendente ou resposta gravada e não enviada, dentro da janela de
# 23 h, no máximo 3 vezes por contato por dia) e apaga da fila os jobs concluídos e falhos além dos
# prazos QUEUE_KEEP_*. 0 desliga a retomada e a limpeza. Só vale com o canal habilitado.
CHANNEL_RESUME_INTERVAL_MINUTES=5
# Contas globais (spec 017). O modo antigo continua disponível até configurar a migração.
ACCOUNTS_ENABLED=false
# Origem exata do site, sem barra final. HTTPS obrigatório em produção.
APP_ORIGIN=http://127.0.0.1:5173
# E-mail por SMTP genérico (spec 019); host, porta e remetente são obrigatórios com ACCOUNTS_ENABLED=true.
# Desenvolvimento: Mailpit nativo (baixe o binário das releases oficiais e execute `mailpit`: SMTP em
# 127.0.0.1:1025, interface em http://127.0.0.1:8025), sem usuário nem senha:
EMAIL_PROVIDER_HOST=127.0.0.1
EMAIL_PROVIDER_PORT=1025
# true = TLS implícito (465); false = STARTTLS (587) ou texto puro, este só em loopback fora de produção.
# Em produção o STARTTLS é sempre exigido. O certificado do servidor é sempre verificado.
EMAIL_PROVIDER_SECURE=false
# Só o endereço (sem nome nem <>); o nome de exibição "Soprei" é fixo no código.
EMAIL_PROVIDER_FROM=noreply@ledware.com.br
# Autenticação opcional, tudo ou nada: ambas preenchidas ou ambas vazias. Gmail: host smtp.gmail.com,
# porta 465, SECURE=true, usuário e senha de app (nunca a senha normal).
EMAIL_PROVIDER_USER=
EMAIL_PROVIDER_PSWD=
# Caixa que recebe os pedidos de contato comercial do site (spec 040, opcional; só o endereço). Vazia =
# EMAIL_PROVIDER_FROM. Use uma caixa que alguém leia (o remetente costuma ser um noreply).
SALES_CONTACT_EMAIL=
# Expurgo de contas nunca confirmadas (spec 021; só com ACCOUNTS_ENABLED=true). Apaga a conta sem
# nenhum vínculo e sem atividade há mais de RETENTION_DAYS dias (1 a 90). A varredura roda no próprio
# processo a cada PURGE_INTERVAL_MINUTES minutos (0 a 1440; 0 desliga).
ACCOUNT_UNVERIFIED_RETENTION_DAYS=7
ACCOUNT_PURGE_INTERVAL_MINUTES=60

# Admin da plataforma (spec 044, E1). Desligado (padrão), as rotas /platform/* não existem (404) e o
# login Bearer da plataforma continua como era. Ligado, exige ADMIN_ORIGIN e as chaves do segundo fator,
# e o POST /auth/platform/login passa a pedir também o código do aplicativo autenticador.
PLATFORM_ADMIN_ENABLED=false
# Origem exata do app do admin (HTTPS em produção; diferente de APP_ORIGIN), ex.: https://soadm.soprei.com
# Em desenvolvimento com `pnpm dev:admin`, o valor é http://127.0.0.1:5175 (o proxy do Vite não
# reescreve o Origin).
# ADMIN_ORIGIN=
# Chaves do segredo TOTP, mesmo formato de CHANNEL_CREDENTIALS_KEYS (keyId:<32 bytes em base64url>,
# separadas por vírgula) e chaves PRÓPRIAS (não reaproveite as do canal). Gerar uma:
# node -e "console.log('k1:' + require('node:crypto').randomBytes(32).toString('base64url'))"
# PLATFORM_TOTP_KEYS=
# PLATFORM_TOTP_ACTIVE_KEY_ID=
# Sessão do admin pelo cookie: prazo ocioso (60 a 86400 s) e teto absoluto (60 a 604800 s, >= ocioso).
PLATFORM_SESSION_IDLE_SECONDS=1800
PLATFORM_SESSION_MAX_SECONDS=43200
