// A URL do banco é lida de DATABASE_URL em prisma.config.ts (Prisma 7).
//
// Isolamento entre empresas: todo model é de TENANT (tem `companyId`) ou GLOBAL (sem
// `companyId`) e precisa estar classificado em src/infrastructure/database/extensions/tenant-scope.ts;
// um teste lê este schema e falha se algum model ficar sem classificação.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum CompanyStatus {
  ACTIVE
  SUSPENDED

  @@map("company_status")
}

/// Raiz do tenant (GLOBAL: não é filtrado por companyId). Soft delete por `deletedAt`;
/// o slug segue único mesmo depois da remoção (fica reservado).
model Company {
  id                    String        @id @default(uuid(7)) @db.Uuid
  name                  String
  slug                  String        @unique
  status                CompanyStatus @default(ACTIVE)
  createdAt             DateTime      @default(now()) @map("created_at")
  updatedAt             DateTime      @updatedAt @map("updated_at")
  deletedAt             DateTime?     @map("deleted_at")
  /// Persona do assistente (até 4000 caracteres; nulo = persona padrão). Nunca vai para log.
  persona               String?
  /// Quando a empresa dispensou o assistente de primeiros passos (spec 030); nulo = nao dispensado.
  onboardingDismissedAt DateTime?     @map("onboarding_dismissed_at") @db.Timestamptz(6)
  /// phone_number_id do número do WhatsApp (Cloud API da Meta) desta empresa: 1 a 32 dígitos, único.
  /// Único ponto do sistema que leva de um identificador externo à empresa (spec 011).
  whatsappPhoneNumberId String?       @unique @map("whatsapp_phone_number_id")

  conversations       Conversation[]
  messages            Message[]
  memberships         Membership[]
  auditEvents         AuditEvent[]
  channelConnection   ChannelConnection?
  invitations         CompanyInvitation[]
  knowledgeDocuments  KnowledgeDocument[]
  knowledgeChunks     KnowledgeChunk[]
  products            Product[]
  stockMovements      StockMovement[]
  scheduleSettings    ScheduleSettings?
  scheduleResources   ScheduleResource[]
  scheduleServices    ScheduleService[]
  availabilityRules   AvailabilityRule[]
  appointments        Appointment[]
  lastUsedByAccounts  Account[]            @relation("AccountLastCompany")
  notifications       Notification[]
  platformAuditEvents PlatformAuditEvent[]
  /// Assinatura da conta dona da empresa (spec 031); gravada na criacao com a cobranca ligada.
  subscriptionId      String?              @map("subscription_id") @db.Uuid
  subscription        Subscription?        @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([subscriptionId])
  @@map("companies")
}

enum MessageRole {
  USER
  ASSISTANT
  /// Mensagem que a equipe enviou pelo aplicativo WhatsApp Business (eco da coexistência, spec 039).
  HUMAN

  @@map("message_role")
}

/// Conversa de um contato com o assistente de uma empresa. `contactRef` é o identificador do
/// contato definido pelo canal (texto livre). (TENANT)
model Conversation {
  id             String    @id @default(uuid(7)) @db.Uuid
  companyId      String    @map("company_id") @db.Uuid
  contactRef     String    @map("contact_ref")
  createdAt      DateTime  @default(now()) @map("created_at")
  updatedAt      DateTime  @updatedAt @map("updated_at")
  /// Spec 039: a IA não responde este contato até este instante (a equipe respondeu pelo celular).
  aiPausedUntil  DateTime? @map("ai_paused_until")
  /// Spec 039: mensagens do contato até este instante foram tratadas pela equipe e nunca são respondidas.
  aiIgnoreBefore DateTime? @map("ai_ignore_before")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  messages      Message[]
  notifications Notification[]

  // `[id, companyId]` existe só para as chaves estrangeiras compostas de Message.
  @@unique([id, companyId])
  @@unique([companyId, contactRef])
  @@index([companyId, createdAt, id])
  // Lista do painel por última atividade (spec 024).
  @@index([companyId, updatedAt, id])
  @@map("conversations")
}

/// Mensagem de uma conversa (do contato ou do assistente). (TENANT)
/// Integridade entre empresas no banco: as chaves estrangeiras são COMPOSTAS com `companyId`,
/// então uma mensagem nunca aponta para conversa nem para outra mensagem de outra empresa.
/// `content` nunca vai para log nem para label de métrica.
model Message {
  id                  String      @id @default(uuid(7)) @db.Uuid
  companyId           String      @map("company_id") @db.Uuid
  conversationId      String      @map("conversation_id") @db.Uuid
  role                MessageRole
  content             String
  isFallback          Boolean     @default(false) @map("is_fallback")
  /// Id da mensagem no canal, para idempotência (único por empresa quando presente).
  externalId          String?     @map("external_id")
  /// Na resposta do assistente, a mensagem do contato a que ela responde.
  replyToId           String?     @map("reply_to_id") @db.Uuid
  createdAt           DateTime    @default(now()) @map("created_at")
  /// Id da mensagem enviada no canal (wamid), só em resposta do assistente já enviada.
  channelMessageId    String?     @map("channel_message_id")
  /// Quando a resposta foi entregue ao canal; nulo = ainda não enviada (ou o envio falhou).
  sentAt              DateTime?   @map("sent_at")
  /// Na mensagem do CONTATO, a resposta do assistente que a atendeu (agrupamento de mensagens, spec 013).
  /// Várias mensagens do mesmo lote apontam para a mesma resposta. Só mensagem USER tem o campo (CHECK).
  answeredById        String?     @map("answered_by_id") @db.Uuid
  /// Spec 035 (revisão, I4): a Meta aceitou o envio (2xx) mas sem id legível; provavelmente entregue, nunca reenviada.
  deliveryUncertainAt DateTime?   @map("delivery_uncertain_at")

  company       Company        @relation(fields: [companyId], references: [id], onDelete: Restrict)
  conversation  Conversation   @relation(fields: [conversationId, companyId], references: [id, companyId], onDelete: NoAction)
  replyTo       Message?       @relation("MessageReply", fields: [replyToId, companyId], references: [id, companyId], onDelete: NoAction)
  replies       Message[]      @relation("MessageReply")
  answeredBy    Message?       @relation("MessageAnswer", fields: [answeredById, companyId], references: [id, companyId], onDelete: NoAction)
  answers       Message[]      @relation("MessageAnswer")
  notifications Notification[]

  @@unique([id, companyId])
  @@unique([companyId, externalId])
  // No máximo uma resposta por mensagem do contato (a retentativa concorrente não duplica).
  @@unique([companyId, replyToId])
  @@index([companyId, conversationId, createdAt, id])
  // Eco de uma resposta nossa reconhecido pelo id do envio (spec 039, defesa).
  @@index([companyId, channelMessageId])
  @@map("messages")
}

enum MembershipRole {
  OWNER
  ADMIN
  AGENT
  VIEWER

  @@map("membership_role")
}

enum AccessStatus {
  ACTIVE
  DISABLED

  @@map("access_status")
}

/// Vínculo de uma conta com uma empresa (TENANT), com papel e estado. E-mail legado normalizado (NFKC, trim, minúsculas), único POR empresa.
/// `passwordHash` (scrypt) nunca vai a log, resposta nem métrica. E-mail também é dado pessoal.
model Membership {
  id           String         @id @default(uuid(7)) @db.Uuid
  companyId    String         @map("company_id") @db.Uuid
  email        String
  passwordHash String         @map("password_hash")
  role         MembershipRole @default(AGENT)
  status       AccessStatus   @default(ACTIVE)
  createdAt    DateTime       @default(now()) @map("created_at")
  updatedAt    DateTime       @updatedAt @map("updated_at")
  accountId    String?        @map("account_id") @db.Uuid
  account      Account?       @relation(fields: [accountId], references: [id], onDelete: Restrict)

  company               Company              @relation(fields: [companyId], references: [id], onDelete: Restrict)
  auditAsActor          AuditEvent[]         @relation("AuditActor")
  auditAsTarget         AuditEvent[]         @relation("AuditTarget")
  invitationsSent       CompanyInvitation[]  @relation("InvitationInviter")
  invitationAccepted    CompanyInvitation[]  @relation("InvitationAccepted")
  knowledgeDocuments    KnowledgeDocument[]  @relation("KnowledgeDocumentCreator")
  stockMovements        StockMovement[]      @relation("StockMovementCreator")
  appointmentsCreated   Appointment[]        @relation("AppointmentCreator")
  notificationsResolved Notification[]       @relation("NotificationResolver")
  platformAuditEvents   PlatformAuditEvent[]

  // `[id, companyId]` existe só para as chaves estrangeiras compostas de AuditEvent (spec 008).
  @@unique([id, companyId])
  @@unique([companyId, email])
  @@unique([companyId, accountId])
  @@index([companyId, createdAt, id])
  @@map("memberships")
}

/// Identidade global da pessoa. O Membership representa a participação dela numa empresa (tenant).
model Account {
  id                        String               @id @default(uuid(7)) @db.Uuid
  email                     String               @unique
  passwordHash              String               @map("password_hash")
  status                    AccessStatus         @default(ACTIVE)
  emailVerifiedAt           DateTime?            @map("email_verified_at") @db.Timestamptz(6)
  verificationHash          String?              @map("verification_hash")
  verificationExpiresAt     DateTime?            @map("verification_expires_at") @db.Timestamptz(6)
  verificationAttempts      Int                  @default(0) @map("verification_attempts") @db.SmallInt
  verificationFailuresDay   Int                  @default(0) @map("verification_failures_day") @db.SmallInt
  verificationFailuresSince DateTime?            @map("verification_failures_since") @db.Timestamptz(6)
  /// Código de recuperação de senha (HMAC, spec 021); nunca em log, resposta nem métrica.
  resetHash                 String?              @map("reset_hash")
  resetExpiresAt            DateTime?            @map("reset_expires_at") @db.Timestamptz(6)
  resetAttempts             Int                  @default(0) @map("reset_attempts") @db.SmallInt
  resetFailuresDay          Int                  @default(0) @map("reset_failures_day") @db.SmallInt
  resetFailuresSince        DateTime?            @map("reset_failures_since") @db.Timestamptz(6)
  /// Última empresa que a conta selecionou (spec 029): só uma dica de conveniência para abrir a empresa
  /// certa depois do login; nunca é autoridade (o `select` e o login revalidam o vínculo ativo).
  lastCompanyId             String?              @map("last_company_id") @db.Uuid
  createdAt                 DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                 DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  memberships               Membership[]
  subscription              Subscription?
  platformAuditEvents       PlatformAuditEvent[]
  lastCompany               Company?             @relation("AccountLastCompany", fields: [lastCompanyId], references: [id], onDelete: SetNull)

  @@index([lastCompanyId])
  @@map("accounts")
}

enum AuditAction {
  MEMBERSHIP_CREATED
  MEMBERSHIP_ROLE_CHANGED
  MEMBERSHIP_DISABLED
  MEMBERSHIP_ENABLED
  MEMBERSHIP_PASSWORD_RESET
  MEMBERSHIP_PASSWORD_CHANGED
  CHANNEL_CONNECTED
  CHANNEL_TOKEN_REPLACED
  CHANNEL_DISCONNECTED
  INVITATION_CREATED
  INVITATION_RESENT
  INVITATION_REVOKED
  INVITATION_ACCEPTED

  @@map("audit_action")
}

/// Trilha de auditoria imutável (TENANT, spec 008). Sem texto livre, sem e-mail, sem IP: só ids e
/// valores de enum. As chaves estrangeiras são COMPOSTAS com `companyId`: um evento nunca aponta para
/// vínculo de outra empresa. A API não atualiza nem apaga eventos; vínculo nunca é apagado (Restrict).
model AuditEvent {
  id                 String          @id @default(uuid(7)) @db.Uuid
  companyId          String          @map("company_id") @db.Uuid
  action             AuditAction
  actorMembershipId  String          @map("actor_membership_id") @db.Uuid
  /// Nulo nas ações CHANNEL_* (spec 015); CHECK no banco: MEMBERSHIP_* exige alvo, CHANNEL_* exige nulo.
  targetMembershipId String?         @map("target_membership_id") @db.Uuid
  fromRole           MembershipRole? @map("from_role")
  toRole             MembershipRole? @map("to_role")
  /// Convite a que o evento se refere (ações INVITATION_*, spec 025); nulo nas demais. Só o id: nunca o e-mail.
  invitationId       String?         @map("invitation_id") @db.Uuid
  createdAt          DateTime        @default(now()) @map("created_at")

  company    Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invitation CompanyInvitation? @relation(fields: [invitationId, companyId], references: [id, companyId], onDelete: Restrict)
  actor      Membership         @relation("AuditActor", fields: [actorMembershipId, companyId], references: [id, companyId], onDelete: Restrict)
  target     Membership?        @relation("AuditTarget", fields: [targetMembershipId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, createdAt, id])
  @@map("audit_events")
}

enum InvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
  EXPIRED

  @@map("invitation_status")
}

/// Convite por e-mail para entrar numa empresa (TENANT, spec 025). O e-mail do convidado (dado pessoal) e o
/// HMAC do segredo existem só enquanto PENDING (CHECK no banco os anula ao fechar). As chaves estrangeiras
/// são COMPOSTAS com `companyId`. O índice único parcial `(company_id, email) WHERE status = 'PENDING'` e os
/// CHECKs só existem na migration (o Prisma não os representa).
model CompanyInvitation {
  id                    String           @id @default(uuid(7)) @db.Uuid
  companyId             String           @map("company_id") @db.Uuid
  email                 String?
  role                  MembershipRole
  status                InvitationStatus @default(PENDING)
  tokenHash             String?          @map("token_hash")
  invitedByMembershipId String           @map("invited_by_membership_id") @db.Uuid
  acceptedMembershipId  String?          @map("accepted_membership_id") @db.Uuid
  expiresAt             DateTime         @map("expires_at") @db.Timestamptz(6)
  lastSentAt            DateTime         @map("last_sent_at") @db.Timestamptz(6)
  sendCount             Int              @default(1) @map("send_count") @db.SmallInt
  createdAt             DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  closedAt              DateTime?        @map("closed_at") @db.Timestamptz(6)

  company            Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  invitedBy          Membership   @relation("InvitationInviter", fields: [invitedByMembershipId, companyId], references: [id, companyId], onDelete: Restrict)
  acceptedMembership Membership?  @relation("InvitationAccepted", fields: [acceptedMembershipId, companyId], references: [id, companyId], onDelete: Restrict)
  auditEvents        AuditEvent[]

  @@unique([id, companyId])
  @@index([companyId, status, createdAt, id])
  @@map("company_invitations")
}

/// Operador da plataforma (GLOBAL: não pertence a empresa alguma). E-mail único global.
model PlatformAdmin {
  id                   String       @id @default(uuid(7)) @db.Uuid
  email                String       @unique
  passwordHash         String       @map("password_hash")
  status               AccessStatus @default(ACTIVE)
  createdAt            DateTime     @default(now()) @map("created_at")
  updatedAt            DateTime     @updatedAt @map("updated_at")
  /// Segredo TOTP CIFRADO (spec 044, AES-256-GCM, chaves PLATFORM_TOTP_KEYS); nulo = sem segundo fator.
  /// Nunca em claro, em log, resposta ou métrica.
  totpSecretCiphertext String?      @map("totp_secret_ciphertext")
  /// Último passo TOTP aceito: o mesmo código não entra duas vezes.
  totpLastStep         Int?         @map("totp_last_step")

  auditEvents PlatformAuditEvent[]

  @@map("platform_admins")
}

enum PlatformAuditAction {
  PLATFORM_LOGIN
  PLATFORM_LOGOUT
  COMPANY_SUSPENDED
  COMPANY_REACTIVATED
  ACCOUNT_EMAIL_VIEWED
  ACCOUNT_DISABLED
  ACCOUNT_ENABLED
  ACCOUNT_SESSIONS_REVOKED
  ACCOUNT_PASSWORD_RESET_SENT
  ACCOUNT_VERIFICATION_SENT
  COMPANY_RENAMED
  COMPANY_REMOVED
  COMPANY_RESTORED
  MEMBERSHIP_ROLE_CHANGED_BY_PLATFORM
  MEMBERSHIP_DISABLED_BY_PLATFORM
  MEMBERSHIP_ENABLED_BY_PLATFORM

  @@map("platform_audit_action")
}

enum PlatformActionReason {
  PAYMENT
  ABUSE
  OWNER_REQUEST
  OTHER

  @@map("platform_action_reason")
}

/// Trilha das ações do administrador da plataforma (GLOBAL, spec 044; imutável: só create e list).
/// Sem texto livre, e-mail nem IP. subject_* dizem sobre quem foi a ação (não é dado da empresa).
model PlatformAuditEvent {
  id                  String                @id @default(uuid(7)) @db.Uuid
  adminId             String                @map("admin_id") @db.Uuid
  action              PlatformAuditAction
  subjectCompanyId    String?               @map("subject_company_id") @db.Uuid
  subjectAccountId    String?               @map("subject_account_id") @db.Uuid
  /// Spec 045, E3: o vínculo alvo (mudar papel, desativar ou reativar) e os papéis de antes e de depois.
  subjectMembershipId String?               @map("subject_membership_id") @db.Uuid
  fromRole            MembershipRole?       @map("from_role")
  toRole              MembershipRole?       @map("to_role")
  reason              PlatformActionReason?
  createdAt           DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)

  admin             PlatformAdmin @relation(fields: [adminId], references: [id], onDelete: Restrict)
  subjectCompany    Company?      @relation(fields: [subjectCompanyId], references: [id], onDelete: Restrict)
  subjectAccount    Account?      @relation(fields: [subjectAccountId], references: [id], onDelete: SetNull)
  subjectMembership Membership?   @relation(fields: [subjectMembershipId], references: [id], onDelete: Restrict)

  @@index([createdAt, id])
  @@index([subjectMembershipId])
  @@index([subjectCompanyId])
  @@index([subjectAccountId])
  @@map("platform_audit_events")
}

enum ChannelConnectionStatus {
  CONNECTED
  TOKEN_INVALID

  @@map("channel_connection_status")
}

/// Como o número foi conectado (spec 039): só pela Cloud API ou em coexistência com o aplicativo
/// WhatsApp Business no celular.
enum ChannelConnectionMode {
  API_ONLY
  COEXISTENCE

  @@map("channel_connection_mode")
}

/// Credencial do canal WhatsApp de uma empresa (TENANT, spec 015): no máximo uma por empresa. O token
/// fica CIFRADO (AES-256-GCM, AAD ligada ao companyId); nunca em claro no banco, em log, resposta nem
/// métrica. O número continua só em `Company.whatsappPhoneNumberId`.
model ChannelConnection {
  id                        String                  @id @default(uuid(7)) @db.Uuid
  companyId                 String                  @unique @map("company_id") @db.Uuid
  wabaId                    String                  @map("waba_id")
  tokenCiphertext           String                  @map("token_ciphertext")
  /// PIN de 6 dígitos do registro do número (Embedded Signup), CIFRADO como o token; nunca em claro,
  /// em log, resposta ou métrica. Nulo quando a conexão veio do PUT manual.
  registrationPinCiphertext String?                 @map("registration_pin_ciphertext")
  tokenVersion              Int                     @default(1) @map("token_version")
  status                    ChannelConnectionStatus @default(CONNECTED)
  mode                      ChannelConnectionMode   @default(API_ONLY)
  tokenExpiresAt            DateTime?               @map("token_expires_at")
  tokenInvalidAt            DateTime?               @map("token_invalid_at")
  createdAt                 DateTime                @default(now()) @map("created_at")
  updatedAt                 DateTime                @updatedAt @map("updated_at")

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("channel_connections")
}

/// Documento de texto da base de conhecimento da IA (TENANT, spec 026). O texto inteiro vive só nos trechos;
/// aqui ficam o tamanho e uma pré-visualização. Título e texto nunca vão a log nem a label de métrica.
model KnowledgeDocument {
  id                    String   @id @default(uuid(7)) @db.Uuid
  companyId             String   @map("company_id") @db.Uuid
  title                 String
  charCount             Int      @map("char_count")
  chunkCount            Int      @map("chunk_count")
  preview               String
  isSample              Boolean  @default(false) @map("is_sample")
  createdByMembershipId String   @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  createdBy Membership       @relation("KnowledgeDocumentCreator", fields: [createdByMembershipId, companyId], references: [id, companyId], onDelete: Restrict)
  chunks    KnowledgeChunk[]

  @@unique([id, companyId])
  @@index([companyId, createdAt, id])
  @@map("knowledge_documents")
}

/// Trecho de um documento (TENANT, spec 026). `content` é o original (vai ao modelo); `searchText` é o mesmo
/// texto (com o título) em minúsculas e sem acentos, só para a busca. O índice GIN de expressão sobre
/// `to_tsvector('portuguese', search_text)` só existe na migration (o Prisma não o representa).
model KnowledgeChunk {
  id         String   @id @default(uuid(7)) @db.Uuid
  companyId  String   @map("company_id") @db.Uuid
  documentId String   @map("document_id") @db.Uuid
  position   Int
  content    String
  searchText String   @map("search_text")
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company           @relation(fields: [companyId], references: [id], onDelete: Restrict)
  document KnowledgeDocument @relation(fields: [documentId, companyId], references: [id, companyId], onDelete: Cascade)

  @@index([companyId, documentId, position])
  @@map("knowledge_chunks")
}

enum StockReason {
  INITIAL
  ENTRY
  EXIT
  LOSS
  COUNT_CORRECTION
  IMPORT

  @@map("stock_reason")
}

/// Produto do estoque da empresa (TENANT, spec 026). SKU único por empresa (maiúsculas). A quantidade só muda
/// por `delta` com movimento no livro (atômico, nunca negativa: CHECK 0 a 1.000.000). Produto não é apagado:
/// "remover" é `active = false`. O índice GIN de expressão em `search_text` só existe na migration.
/// Nome, SKU, descrição e preço nunca vão a log nem a label de métrica.
model Product {
  id                String   @id @default(uuid(7)) @db.Uuid
  companyId         String   @map("company_id") @db.Uuid
  sku               String
  name              String
  description       String   @default("")
  priceCents        Int      @map("price_cents")
  quantity          Int
  lowStockThreshold Int      @default(0) @map("low_stock_threshold")
  active            Boolean  @default(true)
  isSample          Boolean  @default(false) @map("is_sample")
  searchText        String   @map("search_text")
  createdAt         DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company         @relation(fields: [companyId], references: [id], onDelete: Restrict)
  movements StockMovement[]

  @@unique([companyId, sku])
  @@unique([id, companyId])
  @@index([companyId, name, id])
  @@map("products")
}

/// Livro de movimentações de estoque (TENANT, spec 026): imutável (a API só cria e lista) e sem texto livre
/// (o motivo é enum). FKs COMPOSTAS com `companyId`; produto e vínculo nunca são apagados (Restrict).
model StockMovement {
  id                    String      @id @default(uuid(7)) @db.Uuid
  companyId             String      @map("company_id") @db.Uuid
  productId             String      @map("product_id") @db.Uuid
  delta                 Int
  quantityAfter         Int         @map("quantity_after")
  reason                StockReason
  createdByMembershipId String      @map("created_by_membership_id") @db.Uuid
  createdAt             DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)

  company   Company    @relation(fields: [companyId], references: [id], onDelete: Restrict)
  product   Product    @relation(fields: [productId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy Membership @relation("StockMovementCreator", fields: [createdByMembershipId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, productId, createdAt, id])
  @@map("stock_movements")
}

enum AppointmentKind {
  BOOKING
  BLOCK

  @@map("appointment_kind")
}

enum AppointmentStatus {
  PENDING
  CONFIRMED
  CANCELLED
  COMPLETED
  NO_SHOW

  @@map("appointment_status")
}

enum AppointmentSource {
  PANEL
  CHANNEL

  @@map("appointment_source")
}

enum AppointmentCancelledBy {
  PANEL
  CONTACT

  @@map("appointment_cancelled_by")
}

/// Configuração da agenda da empresa (TENANT, spec 027): uma linha por empresa, criada sob demanda.
model ScheduleSettings {
  id               String   @id @default(uuid(7)) @db.Uuid
  companyId        String   @unique @map("company_id") @db.Uuid
  timezone         String   @default("America/Sao_Paulo")
  slotStepMinutes  Int      @default(30) @map("slot_step_minutes")
  minNoticeMinutes Int      @default(120) @map("min_notice_minutes")
  maxAdvanceDays   Int      @default(60) @map("max_advance_days")
  /// Spec 028: a IA pode solicitar, cancelar e remarcar horarios (padrao desligado; CHECK: auto-confirmar implica ligado).
  aiBookingEnabled Boolean  @default(false) @map("ai_booking_enabled")
  aiAutoConfirm    Boolean  @default(false) @map("ai_auto_confirm")
  createdAt        DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company Company @relation(fields: [companyId], references: [id], onDelete: Restrict)

  @@map("schedule_settings")
}

/// Recurso da agenda (TENANT, spec 027): profissional, sala ou "Agenda principal".
model ScheduleResource {
  id        String   @id @default(uuid(7)) @db.Uuid
  companyId String   @map("company_id") @db.Uuid
  name      String
  active    Boolean  @default(true)
  position  Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company            @relation(fields: [companyId], references: [id], onDelete: Restrict)
  rules        AvailabilityRule[]
  appointments Appointment[]

  @@unique([id, companyId])
  @@index([companyId, position, id])
  @@map("schedule_resources")
}

/// Serviço agendável (TENANT, spec 027). Não é apagado (agendamentos o referenciam): só `active = false`.
model ScheduleService {
  id              String   @id @default(uuid(7)) @db.Uuid
  companyId       String   @map("company_id") @db.Uuid
  name            String
  durationMinutes Int      @map("duration_minutes")
  bufferMinutes   Int      @default(0) @map("buffer_minutes")
  active          Boolean  @default(true)
  isSample        Boolean  @default(false) @map("is_sample")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  company      Company       @relation(fields: [companyId], references: [id], onDelete: Restrict)
  appointments Appointment[]

  @@unique([id, companyId])
  @@index([companyId, name, id])
  @@map("schedule_services")
}

/// Janela semanal de atendimento de um recurso (TENANT, spec 027), em minutos do relógio local da empresa.
model AvailabilityRule {
  id          String   @id @default(uuid(7)) @db.Uuid
  companyId   String   @map("company_id") @db.Uuid
  resourceId  String   @map("resource_id") @db.Uuid
  weekday     Int
  startMinute Int      @map("start_minute")
  endMinute   Int      @map("end_minute")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  company  Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  resource ScheduleResource @relation(fields: [resourceId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, resourceId, weekday])
  @@map("availability_rules")
}

/// Agendamento ou bloqueio (TENANT, spec 027). A restrição de exclusão (`EXCLUDE USING gist`, extensão
/// `btree_gist`) que impede dois itens ativos (PENDING/CONFIRMED) sobrepostos no mesmo recurso só existe na
/// migration (o Prisma não a representa). Nome de serviço, `customerLabel`, `contactRef` e horários nunca vão a log.
model Appointment {
  id                    String                  @id @default(uuid(7)) @db.Uuid
  companyId             String                  @map("company_id") @db.Uuid
  resourceId            String                  @map("resource_id") @db.Uuid
  serviceId             String?                 @map("service_id") @db.Uuid
  kind                  AppointmentKind
  status                AppointmentStatus
  startsAt              DateTime                @map("starts_at") @db.Timestamptz(6)
  endsAt                DateTime                @map("ends_at") @db.Timestamptz(6)
  /// `endsAt` mais o intervalo (buffer) do serviço na hora da reserva: o que bloqueia o recurso.
  blockedUntil          DateTime                @map("blocked_until") @db.Timestamptz(6)
  customerLabel         String?                 @map("customer_label")
  /// Só o canal preenche (Anexo B da spec); nunca sai em resposta de API.
  contactRef            String?                 @map("contact_ref")
  source                AppointmentSource
  createdByMembershipId String?                 @map("created_by_membership_id") @db.Uuid
  cancelledAt           DateTime?               @map("cancelled_at") @db.Timestamptz(6)
  cancelledBy           AppointmentCancelledBy? @map("cancelled_by")
  createdAt             DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)

  company   Company          @relation(fields: [companyId], references: [id], onDelete: Restrict)
  resource  ScheduleResource @relation(fields: [resourceId, companyId], references: [id, companyId], onDelete: Restrict)
  service   ScheduleService? @relation(fields: [serviceId, companyId], references: [id, companyId], onDelete: Restrict)
  createdBy Membership?      @relation("AppointmentCreator", fields: [createdByMembershipId, companyId], references: [id, companyId], onDelete: Restrict)

  @@index([companyId, startsAt, id])
  @@index([companyId, resourceId, startsAt])
  @@map("appointments")
}

enum PlanCode {
  ESSENTIAL
  PROFESSIONAL
  SCALE

  @@map("plan_code")
}

enum BillingCycle {
  MONTHLY
  ANNUAL

  @@map("billing_cycle")
}

enum SubscriptionStatus {
  TRIAL
  ACTIVE
  PAST_DUE
  CANCELLED
  EXPIRED

  @@map("subscription_status")
}

enum WhatsappBillingMode {
  CUSTOMER_PAYS_META
  SOPREI_PAYS_META

  @@map("whatsapp_billing_mode")
}

enum PaymentOrderKind {
  NEW
  RENEWAL
  UPGRADE
  EXTRA_PACK

  @@map("payment_order_kind")
}

enum PaymentOrderStatus {
  PENDING
  PAID
  EXPIRED
  FAILED

  @@map("payment_order_status")
}

enum PaymentNoticeKind {
  QUOTA_REPLIES_80
  QUOTA_REPLIES_100
  QUOTA_TOKENS_80
  QUOTA_TOKENS_100
  PERIOD_ENDING_7D
  PERIOD_ENDING_1D
  PERIOD_ENDED
  PRICE_CHANGE
  PERIOD_GRACE_ENDED
  PAYMENT_RECEIVED
  PLAN_CHANGE_APPLIED
  DOWNGRADE_BLOCKED
  TRIAL_ENDING
  TRIAL_ENDED

  @@map("payment_notice_kind")
}

/// Plano do catalogo (GLOBAL, spec 031). Versionado e append-only: mudar cota ou limite e linha nova.
model Plan {
  id                     String   @id @default(uuid(7)) @db.Uuid
  code                   PlanCode
  name                   String
  maxCompanies           Int      @map("max_companies")
  monthlyTokens          BigInt   @map("monthly_tokens")
  monthlyReplies         Int      @map("monthly_replies")
  /// Estimativa do custo da Meta por mensagem enviada, em milesimos de centavo (so exibicao, S9).
  metaEstimateMilliCents Int      @map("meta_estimate_milli_cents")
  version                Int      @default(1)
  active                 Boolean  @default(true)
  createdAt              DateTime @default(now()) @map("created_at") @db.Timestamptz(6)

  prices        PlanPrice[]
  subscriptions Subscription[]

  @@unique([code, version])
  @@map("plans")
}

/// Preco versionado de um plano (GLOBAL, spec 031), em centavos de BRL. Append-only: preco novo e linha nova.
model PlanPrice {
  id                     String              @id @default(uuid(7)) @db.Uuid
  planId                 String              @map("plan_id") @db.Uuid
  cycle                  BillingCycle
  baseCents              Int                 @map("base_cents")
  agendaCents            Int                 @map("agenda_cents")
  stockCents             Int                 @map("stock_cents")
  whatsappBillingMode    WhatsappBillingMode @default(CUSTOMER_PAYS_META) @map("whatsapp_billing_mode")
  metaPerReplyMilliCents Int                 @map("meta_per_reply_milli_cents")
  extraPackCents         Int                 @map("extra_pack_cents")
  extraPackReplies       Int                 @map("extra_pack_replies")
  version                Int                 @default(1)
  validFrom              DateTime            @map("valid_from") @db.Timestamptz(6)
  createdAt              DateTime            @default(now()) @map("created_at") @db.Timestamptz(6)

  plan          Plan           @relation(fields: [planId], references: [id], onDelete: Restrict)
  subscriptions Subscription[]

  @@unique([planId, cycle, whatsappBillingMode, version])
  @@map("plan_prices")
}

/// Assinatura de uma CONTA (GLOBAL, spec 031; no maximo uma por conta). Acesso sempre por AccountId ou
/// SubscriptionId (repositorios de cobranca); nenhuma rota recebe o id da conta do navegador.
model Subscription {
  id                 String             @id @default(uuid(7)) @db.Uuid
  accountId          String             @unique @map("account_id") @db.Uuid
  planId             String             @map("plan_id") @db.Uuid
  priceId            String             @map("price_id") @db.Uuid
  cycle              BillingCycle
  agendaEnabled      Boolean            @default(false) @map("agenda_enabled")
  stockEnabled       Boolean            @default(false) @map("stock_enabled")
  status             SubscriptionStatus
  currentPeriodStart DateTime           @map("current_period_start") @db.Timestamptz(6)
  currentPeriodEnd   DateTime           @map("current_period_end") @db.Timestamptz(6)
  trialEndsAt        DateTime?          @map("trial_ends_at") @db.Timestamptz(6)
  cancelAtPeriodEnd  Boolean            @default(false) @map("cancel_at_period_end")
  /// Plano, ciclo e modulos do proximo ciclo (so ids e flags); nulo = nenhuma mudanca agendada.
  pendingChange      Json?              @map("pending_change")
  createdAt          DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  account   Account         @relation(fields: [accountId], references: [id], onDelete: Restrict)
  plan      Plan            @relation(fields: [planId], references: [id], onDelete: Restrict)
  price     PlanPrice       @relation(fields: [priceId], references: [id], onDelete: Restrict)
  companies Company[]
  orders    PaymentOrder[]
  usage     UsageCounter[]
  notices   PaymentNotice[]

  @@index([planId])
  @@index([priceId])
  @@map("subscriptions")
}

/// Pedido de pagamento (GLOBAL, spec 031; usado a partir do E3). Guarda so ids, valores, datas e estado:
/// nunca cartao nem corpo cru de webhook.
model PaymentOrder {
  id                     String             @id @default(uuid(7)) @db.Uuid
  subscriptionId         String             @map("subscription_id") @db.Uuid
  kind                   PaymentOrderKind
  amountCents            Int                @map("amount_cents")
  /// Plano, ciclo, modulos e versao de preco copiados no momento do pedido.
  breakdown              Json
  status                 PaymentOrderStatus @default(PENDING)
  checkoutUrl            String?            @map("checkout_url")
  providerTransactionRef String?            @map("provider_transaction_ref")
  /// Identificador da fatura na InfinitePay (invoice_slug), so para a consulta de status (spec 031, E3).
  providerSlug           String?            @map("provider_slug")
  /// Forma de pagamento informada pela consulta (pix ou credit_card); so numeros e texto curto fixo.
  captureMethod          String?            @map("capture_method")
  /// Ultima consulta de status feita pela reconciliacao (marca de reivindicacao entre instancias).
  lastCheckedAt          DateTime?          @map("last_checked_at") @db.Timestamptz(6)
  paidAt                 DateTime?          @map("paid_at") @db.Timestamptz(6)
  periodStart            DateTime?          @map("period_start") @db.Timestamptz(6)
  periodEnd              DateTime?          @map("period_end") @db.Timestamptz(6)
  expiresAt              DateTime           @map("expires_at") @db.Timestamptz(6)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@index([subscriptionId, createdAt])
  @@index([status, createdAt])
  @@map("payment_orders")
}

/// Uso medido por janela mensal de uma assinatura (GLOBAL, spec 031): so numeros, nunca texto nem contato.
model UsageCounter {
  id             String   @id @default(uuid(7)) @db.Uuid
  subscriptionId String   @map("subscription_id") @db.Uuid
  windowStart    DateTime @map("window_start") @db.Timestamptz(6)
  tokens         BigInt   @default(0)
  sentMessages   BigInt   @default(0) @map("sent_messages")
  extraReplies   Int      @default(0) @map("extra_replies")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, windowStart])
  @@map("usage_counters")
}

/// Marca de aviso ja enviado ao dono (GLOBAL, spec 031): o e-mail nao se repete na mesma janela.
model PaymentNotice {
  id             String            @id @default(uuid(7)) @db.Uuid
  subscriptionId String            @map("subscription_id") @db.Uuid
  kind           PaymentNoticeKind
  windowStart    DateTime          @map("window_start") @db.Timestamptz(6)
  createdAt      DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Restrict)

  @@unique([subscriptionId, kind, windowStart])
  @@map("payment_notices")
}

enum NotificationKind {
  HUMAN_HANDOFF

  @@map("notification_kind")
}

enum NotificationStatus {
  OPEN
  RESOLVED

  @@map("notification_status")
}

enum HandoffReason {
  CONTACT_REQUESTED
  CANNOT_HELP
  COMPLAINT
  SENSITIVE
  OTHER

  @@map("handoff_reason")
}

/// Notificação do painel (spec 038). (TENANT)
/// Hoje só `HUMAN_HANDOFF`: a IA pediu atendimento humano numa conversa. Estado da EMPRESA (não por
/// pessoa). Nunca guarda texto de mensagem. FKs COMPOSTAS com `companyId`. Uma aberta por conversa e
/// tipo: índice único PARCIAL só na migration (o Prisma não o representa). CHECKs na migration.
model Notification {
  id                     String             @id @default(uuid(7)) @db.Uuid
  companyId              String             @map("company_id") @db.Uuid
  kind                   NotificationKind
  reason                 HandoffReason?
  conversationId         String             @map("conversation_id") @db.Uuid
  messageId              String             @map("message_id") @db.Uuid
  status                 NotificationStatus @default(OPEN)
  createdAt              DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  resolvedAt             DateTime?          @map("resolved_at") @db.Timestamptz(6)
  resolvedByMembershipId String?            @map("resolved_by_membership_id") @db.Uuid

  company      Company      @relation(fields: [companyId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId, companyId], references: [id, companyId], onDelete: NoAction)
  message      Message      @relation(fields: [messageId, companyId], references: [id, companyId], onDelete: NoAction)
  resolvedBy   Membership?  @relation("NotificationResolver", fields: [resolvedByMembershipId, companyId], references: [id, companyId], onDelete: Restrict)

  @@unique([id, companyId])
  @@index([companyId, status, createdAt, id])
  @@index([companyId, conversationId])
  @@map("notifications")
}
