# Exemplo do backend/.env do STAGING (spec 037, E2): só nomes e marcadores <ASSIM>, nenhum valor
# secreto. Copie para /var/www/soprei-staging/backend/.env (modo 600) e troque cada marcador por um
# valor NOVO, diferente de qualquer valor da produção (guarde também no gerenciador de senhas do dono).
# O teste deploy-scripts.test.ts preenche os marcadores com valores sintéticos e valida este arquivo
# com o mesmo schema do boot: se uma variável mudar de nome, este exemplo e o teste quebram juntos.
#
# O staging NÃO recebe: chave da Anthropic, variáveis da Meta (WHATSAPP_*), da InfinitePay
# (INFINITEPAY_*) nem SMTP real. Nenhuma variável aqui repete um segredo da produção.

# Mesmas regras de configuração da produção (HTTPS na origem, cookie Secure, rate limit ligado...).
NODE_ENV=production
HOST=127.0.0.1
PORT=3002

# Origem exata do site do staging (o cookie e o Origin valem só para ela).
APP_ORIGIN=https://<HOSTNAME_DO_STAGING>
# O nginx é o proxy (mesmo valor lógico da produção).
TRUST_PROXY=127.0.0.1,::1

# Banco e role próprios (sem acesso ao banco da produção).
DATABASE_URL=postgresql://soprei_staging:<SENHA_DO_BANCO_STAGING>@127.0.0.1:5432/soprei_staging
DB_POOL_MAX=5

# Instância própria do Redis (porta 6380, senha diferente da produção, banco /0).
REDIS_URL=redis://:<SENHA_DO_REDIS_STAGING>@127.0.0.1:6380/0

# NOVO e diferente da produção: um token, código ou convite de um ambiente nunca vale no outro.
JWT_SECRET=<JWT_SECRET_NOVO>
METRICS_TOKEN=<METRICS_TOKEN_NOVO>

# Contas e e-mail: Mailpit local (D4), STARTTLS com a autoridade privada do dono.
ACCOUNTS_ENABLED=true
EMAIL_PROVIDER_HOST=localhost
EMAIL_PROVIDER_PORT=1025
EMAIL_PROVIDER_SECURE=false
EMAIL_PROVIDER_FROM=staging@<HOSTNAME_DO_STAGING>

# Sem IA real, sem canal, sem cobrança e sem IA de agenda.
LLM_PROVIDER=mock
WHATSAPP_ENABLED=false
BILLING_ENABLED=false
CHECKOUT_ENABLED=false
SCHEDULE_AI_ENABLED=false

RATE_LIMIT_ENABLED=true
LOG_LEVEL=info

# Maior que a espera do worker; o kill_timeout do PM2 (deploy/ecosystem.config.cjs) é 5 s acima deste.
SHUTDOWN_TIMEOUT_MS=60000
