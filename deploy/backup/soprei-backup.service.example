# Exemplo de /etc/systemd/system/soprei-backup.service (spec 043).
[Unit]
Description=Soprei: backup diario do banco, cifrado e enviado para fora do servidor
After=postgresql.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
User=root
UMask=0077
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/usr/local/sbin/soprei-backup
Nice=10
IOSchedulingClass=idle
TimeoutStartSec=3600
