# nginx da PRODUÇÃO do Soprei: /etc/nginx/sites-available/soprei (ligado em sites-enabled/soprei).
#
# CONFERIDO com o arquivo real do servidor em 2026-11-24 (spec 044, publicação do admin): este exemplo é o
# arquivo de lá, com duas diferenças marcadas "FALTA NO SERVIDOR" abaixo, que o dono acrescenta à mão. Ao
# mudar o servidor, mude este exemplo junto (e vice-versa); ele substitui o reconstruído da spec 037 (S20).
#
# Certificado pelo `certbot --nginx` (as linhas "managed by Certbot" são dele): um certificado só, em
# /etc/letsencrypt/live/soprei.com/, vale para soprei.com e www.soprei.com. Cloudflare sem proxy (somente
# DNS). Com o proxy ligado seria preciso real_ip no nginx e TRUST_PROXY com as faixas dela (fora de escopo).
#
# Log de acesso: o formato soprei_prod_sem_query (sem query string e sem o caminho do webhook de pagamento,
# spec 032, D13) é definido FORA deste arquivo no servidor, no contexto http. Não o declare aqui de novo: o
# nginx recusa um log_format repetido. A definição, para referência:
#
#   map $request_uri $soprei_prod_log_path {
#       ~^/webhooks/infinitepay/        "/webhooks/infinitepay/[oculto]";
#       ~^(?<soprei_prod_path>[^?]*)    $soprei_prod_path;
#   }
#   log_format soprei_prod_sem_query '$remote_addr - $remote_user [$time_local] '
#                                    '"$request_method $soprei_prod_log_path $server_protocol" '
#                                    '$status $body_bytes_sent "$http_user_agent"';
#
# ATENÇÃO: o error.log não usa esse formato e ainda pode guardar o caminho do webhook com o token e a query do
# handshake do WhatsApp (hub.verify_token) quando uma requisição dá erro. Rotação com prazo de 30 dias
# (logrotate) do access.log E do error.log, e dos logs do PM2, é passo do dono no servidor.

# soprei.com (sem www) vai para www.soprei.com.
server {
    server_name soprei.com;
    return 301 https://www.soprei.com$request_uri;

    listen [::]:443 ssl ipv6only=on; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/soprei.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/soprei.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

server {
    server_name www.soprei.com;

    # Site estático: frontend/dist é um atalho para a release atual (deploy/deploy.sh).
    root /var/www/soprei/frontend/dist;
    index index.html;
    client_max_body_size 4m;
    access_log /var/log/nginx/access.log soprei_prod_sem_query;

    # API: o prefixo /api/ é removido antes de chegar ao backend (porta 3001, só em 127.0.0.1). O
    # X-Forwarded-For é SUBSTITUÍDO pelo IP de quem conectou (o backend usa TRUST_PROXY=127.0.0.1,::1).
    location /api/ {
        proxy_pass http://127.0.0.1:3001/;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Admin da plataforma (spec 044): /platform/* só pelo hostname do admin (deploy/nginx/admin.conf.example).
    # Defesa em profundidade: o cookie do admin já não vem a este hostname. Acrescentado no servidor em
    # 2026-11-24.
    location /api/platform/ {
        return 404;
    }

    # Webhooks da Meta e da InfinitePay.
    location /webhooks/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # FALTA NO SERVIDOR (conferido em 2026-11-24: o worker sai como application/octet-stream e o navegador
    # recusa, então a leitura de PDF da aba Conhecimento falha). Worker do pdf.js (spec 041): o .mjs precisa
    # sair como JavaScript. Location por regex: vence o prefixo /assets/ abaixo.
    location ~* \.mjs$ {
        types { text/javascript mjs; }
        try_files $uri =404;
    }

    # Arquivos com hash no nome: cache de um ano.
    location /assets/ {
        expires 1y;
        add_header Cache-Control "public, immutable";
    }

    # Páginas legais estáticas (spec 032, E1): /privacidade serve privacidade.html; o resto cai no SPA.
    location / {
        try_files $uri $uri.html /index.html;
        add_header Cache-Control "no-cache";
    }

    listen [::]:443 ssl; # managed by Certbot
    listen 443 ssl; # managed by Certbot
    ssl_certificate /etc/letsencrypt/live/soprei.com/fullchain.pem; # managed by Certbot
    ssl_certificate_key /etc/letsencrypt/live/soprei.com/privkey.pem; # managed by Certbot
    include /etc/letsencrypt/options-ssl-nginx.conf; # managed by Certbot
    ssl_dhparam /etc/letsencrypt/ssl-dhparams.pem; # managed by Certbot
}

# Porta 80: o certbot redireciona para https.
server {
    if ($host = soprei.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name soprei.com;
    return 404; # managed by Certbot
}

server {
    if ($host = www.soprei.com) {
        return 301 https://$host$request_uri;
    } # managed by Certbot

    listen 80;
    listen [::]:80;
    server_name www.soprei.com;
    return 404; # managed by Certbot
}
