# nginx da PRODUÇÃO do Soprei, como o repositório entende que ele é (spec 037, E2).
#
# ATENÇÃO: este arquivo foi RECONSTRUÍDO a partir da descrição do desenho (site e API no mesmo
# hostname, /api/ com o prefixo removido e /webhooks/ para 127.0.0.1:3001, certbot) e NÃO foi copiado
# do servidor (S20 da spec). O dono deve conferir com o arquivo real, ajustar este exemplo para ficar
# igual a ele (sem segredo) e só então confiar nele como documentação. Ao conferir, troque também o
# hostname abaixo se for outro.
#
# Cloudflare sem proxy (somente DNS). Com o proxy ligado seria preciso real_ip no nginx e TRUST_PROXY
# com as faixas dela (fora de escopo).

# Log de acesso sem query string e sem o caminho completo do webhook de pagamento (spec 032, D13): a query
# do handshake do WhatsApp leva o hub.verify_token e o caminho /webhooks/infinitepay/<pedido>/<token> leva um
# token. Os nomes (soprei_prod_*) são únicos por arquivo porque produção e staging podem dividir o mesmo nginx
# (log_format e map ficam no contexto http, que inclui este arquivo).
# ATENÇÃO: o error.log não usa este formato e ainda pode guardar o caminho do webhook com o token e a query do
# handshake do WhatsApp (hub.verify_token) quando uma requisição dá erro. Rotação com prazo de 30 dias
# (logrotate) do access.log E do error.log, e dos logs do PM2, é passo do dono no servidor.
map $request_uri $soprei_prod_log_path {
    ~^/webhooks/infinitepay/        "/webhooks/infinitepay/[oculto]";
    ~^(?<soprei_prod_path>[^?]*)    $soprei_prod_path;
}
log_format soprei_prod_sem_query '$remote_addr - $remote_user [$time_local] '
                                 '"$request_method $soprei_prod_log_path $server_protocol" '
                                 '$status $body_bytes_sent "$http_user_agent"';

server {
    listen 80;
    listen [::]:80;
    server_name www.soprei.com;
    access_log /var/log/nginx/access.log soprei_prod_sem_query;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name www.soprei.com;

    ssl_certificate /etc/letsencrypt/live/www.soprei.com/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/www.soprei.com/privkey.pem;

    # Site estático: frontend/dist é um atalho para a release atual (deploy/deploy.sh).
    root /var/www/soprei/frontend/dist;
    index index.html;
    access_log /var/log/nginx/access.log soprei_prod_sem_query;

    # API: o prefixo /api/ é removido antes de chegar ao backend (porta 3001, só em 127.0.0.1).
    location /api/ {
        proxy_pass http://127.0.0.1:3001/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # ACRESCENTA ao X-Forwarded-For (o backend usa TRUST_PROXY=127.0.0.1,::1).
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Webhooks da Meta e da InfinitePay.
    location /webhooks/ {
        proxy_pass http://127.0.0.1:3001;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
    }

    # Worker do pdf.js (spec 041): o .mjs precisa sair como JavaScript (o mime.types de versões antigas
    # do nginx não conhece a extensão e o navegador recusa o worker servido como octet-stream).
    location ~* \.mjs$ {
        types { text/javascript mjs; }
        try_files $uri =404;
    }

    # Páginas legais estáticas (spec 032, E1): /privacidade serve privacidade.html; o resto cai no SPA.
    location / {
        try_files $uri $uri.html /index.html;
    }
}
