# nginx do STAGING do Soprei (spec 037, E2). Exemplo: o dono copia para
# /etc/nginx/sites-available/soprei-staging, troca <HOSTNAME_DO_STAGING> e roda o certbot (mesmo
# procedimento da produção, que reescreve os blocos de certificado e o redirecionamento).
#
# Senha básica (D5): o cadastro do staging fica aberto, então sem a senha qualquer pessoa da internet
# poderia criar contas no ambiente de teste. O arquivo de senhas NÃO está no repositório:
#   htpasswd -c /etc/nginx/soprei-staging.htpasswd <usuario>     (como root; modo 640, grupo www-data)
# Nenhum cabeçalho Authorization chega à API (a senha básica não pode vazar para ela, S6 da spec).

# Log de acesso sem query string e sem o caminho completo do webhook de pagamento (spec 032, D13): a query
# do handshake do WhatsApp leva o hub.verify_token e o caminho /webhooks/infinitepay/<pedido>/<token> leva um
# token. Os nomes (soprei_staging_*) são únicos por arquivo porque produção e staging podem dividir o mesmo nginx
# (log_format e map ficam no contexto http, que inclui este arquivo).
# ATENÇÃO: o error.log não usa este formato e ainda pode guardar o caminho do webhook com o token e a query do
# handshake do WhatsApp (hub.verify_token) quando uma requisição dá erro. Rotação com prazo de 30 dias
# (logrotate) do access.log E do error.log, e dos logs do PM2, é passo do dono no servidor.
map $request_uri $soprei_staging_log_path {
    ~^/webhooks/infinitepay/           "/webhooks/infinitepay/[oculto]";
    ~^(?<soprei_staging_path>[^?]*)    $soprei_staging_path;
}
log_format soprei_staging_sem_query '$remote_addr - $remote_user [$time_local] '
                                    '"$request_method $soprei_staging_log_path $server_protocol" '
                                    '$status $body_bytes_sent "$http_user_agent"';

server {
    listen 80;
    listen [::]:80;
    server_name <HOSTNAME_DO_STAGING>;
    access_log /var/log/nginx/access.log soprei_staging_sem_query;
    return 301 https://$host$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name <HOSTNAME_DO_STAGING>;

    ssl_certificate /etc/letsencrypt/live/<HOSTNAME_DO_STAGING>/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/<HOSTNAME_DO_STAGING>/privkey.pem;

    # Staging não é indexado e só entra quem tem a senha.
    add_header X-Robots-Tag "noindex, nofollow" always;
    auth_basic "Soprei staging";
    auth_basic_user_file /etc/nginx/soprei-staging.htpasswd;

    # Site estático: frontend/dist é um atalho para a release atual (deploy/deploy.sh).
    root /var/www/soprei-staging/frontend/dist;
    index index.html;
    access_log /var/log/nginx/access.log soprei_staging_sem_query;

    # API: o prefixo /api/ é removido antes de chegar ao backend (porta 3002, só em 127.0.0.1).
    location /api/ {
        proxy_pass http://127.0.0.1:3002/;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        # ACRESCENTA ao X-Forwarded-For (o backend usa TRUST_PROXY=127.0.0.1,::1).
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "";
    }

    # Webhooks (no staging o canal WhatsApp e o checkout ficam desligados; a rota existe só por paridade).
    location /webhooks/ {
        proxy_pass http://127.0.0.1:3002;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header Authorization "";
    }

    # Worker do pdf.js (spec 041): o .mjs precisa sair como JavaScript (o mime.types de versões antigas
    # do nginx não conhece a extensão e o navegador recusa o worker servido como octet-stream).
    location ~* \.mjs$ {
        types { text/javascript mjs; }
        try_files $uri =404;
    }

    # Páginas legais estáticas (spec 032, E1): /privacidade serve privacidade.html; o resto cai no SPA.
    location / {
        try_files $uri $uri.html /index.html;
    }
}
