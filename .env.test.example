# Copie para .env.test (cp .env.test.example .env.test). Nunca commite o .env.test.
# Lido só por `pnpm test:integration`. Os testes de integração se recusam a rodar se o
# banco não for "soprei_test" ou se o Redis não for o índice 15.

NODE_ENV=test
LOG_LEVEL=silent

# Banco de testes (nunca o de desenvolvimento)
DATABASE_URL=postgresql://soprei:<senha>@localhost:5432/soprei_test?schema=public

# Redis de testes: índice 15
REDIS_URL=redis://localhost:6379/15

# Chave de administração (opcional em teste; os testes de rota usam chaves próprias, geradas por eles).
# Deixe em branco, a menos que queira exercitar /admin manualmente contra o banco de testes.
# ADMIN_API_KEY=

# Token de /metrics (opcional; mínimo de 32 caracteres se informado). Os testes de rota usam
# tokens próprios, gerados por eles; deixe em branco, a menos que queira exercitar /metrics à mão.
# METRICS_TOKEN=
