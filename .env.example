# Copie para .env (cp .env.example .env) e ajuste. Nunca commite o .env.
# Todas as variáveis são validadas no boot em src/infrastructure/config/.

# Ambiente de execução: development | test | production
NODE_ENV=development

# Endereço e porta em que o servidor HTTP escuta
HOST=0.0.0.0
PORT=3000

# Nível de log do Pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL nativo (obrigatória). Role "soprei" e banco "soprei": ver "Ambiente local" no CLAUDE.md.
# Troque <senha> pela senha escolhida ao criar o role (com caracteres especiais, use URL-encode).
DATABASE_URL=postgresql://soprei:<senha>@localhost:5432/soprei?schema=public

# Redis nativo (obrigatória). Índice 0 para desenvolvimento; os testes usam o 15 (ver .env.test.example).
REDIS_URL=redis://localhost:6379/0

# Pool de conexões do PostgreSQL (opcionais; os valores abaixo são os defaults)
# Máximo de conexões abertas (1 a 200)
DB_POOL_MAX=10
# Tempo para fechar uma conexão ociosa, em ms (1 a 3600000)
DB_POOL_IDLE_TIMEOUT_MS=30000
# Tempo máximo esperando uma conexão do pool, em ms (1 a 120000)
DB_POOL_CONNECTION_TIMEOUT_MS=5000
# Tempo máximo de uma query no servidor, em ms (1 a 600000)
DB_STATEMENT_TIMEOUT_MS=30000

# Chave de administração das rotas /admin (spec 003), enviada em "Authorization: Bearer <chave>".
# Credencial temporária e válida para TODOS os clientes: o destino dela é decidido nas specs 007/008.
# Opcional em desenvolvimento e teste (sem ela, /admin responde 401); em produção é obrigatória,
# com no mínimo 32 caracteres. Para gerar: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# ADMIN_API_KEY=

# Token do endpoint GET /metrics (spec 004), enviado em "Authorization: Bearer <token>".
# Opcional. Sem ele, /metrics NÃO existe (responde 404), para não expor métricas por engano.
# Se informado, precisa ter no mínimo 32 caracteres; vazio vale como ausente.
# Para gerar: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# METRICS_TOKEN=

# Atendimento (spec 010). Todas opcionais; os valores abaixo são os defaults.
# Provedor de LLM por trás da interface LlmProvider. Por ora só "mock" (determinístico, sem rede);
# o provedor real entra em spec própria. Trocar de modelo é mudar esta variável, não código de negócio.
LLM_PROVIDER=mock
# Prazo máximo de uma chamada ao LLM, em ms (1 a 120000). Estourou: o contato recebe o texto padrão de falha.
LLM_TIMEOUT_MS=15000
# Uma mensagem do contato sem resposta há mais que isto (ms, 1 a 3600000) deixa de estar "em andamento":
# a retentativa com o mesmo externalId completa o fluxo em vez de receber 409.
ATTENDANCE_IN_FLIGHT_TIMEOUT_MS=60000

# Rate limiting (spec 005). Todas opcionais; os valores abaixo são os defaults.
# Limites por perfil e por IP, guardados no Redis (valem entre várias instâncias). Estourou: 429.
# Liga/desliga ("true" ou "false" literais). "false" é rejeitado com NODE_ENV=production.
RATE_LIMIT_ENABLED=true
# Cada perfil: máximo de requisições (1 a 1000000) por janela em segundos (1 a 86400).
# public: rede de segurança, vale para toda rota sem perfil declarado
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=900
# admin: rotas /admin/*
RATE_LIMIT_ADMIN_MAX=600
RATE_LIMIT_ADMIN_WINDOW_SECONDS=60
# webhook: webhook do canal de mensagens (spec 011). Folgado de propósito: 429 faz a Meta retentar.
RATE_LIMIT_WEBHOOK_MAX=600
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60
# Prazo de cada comando Redis do limiter, em ms (1 a 10000). Redis fora ou lento custa no máximo isto
# por requisição, que passa em fail-open (com log de erro e a métrica rate_limit_store_errors_total).
RATE_LIMIT_REDIS_TIMEOUT_MS=250
# De onde vem o IP do cliente (a chave do limite). Padrão false: X-Forwarded-For é IGNORADO.
#   false            ignora X-Forwarded-For (o servidor recebe conexões direto dos clientes)
#   1                um proxy confiável à frente (túnel Cloudflare/ngrok, nginx...): o IP é o que ele
#                    acrescenta ao fim de X-Forwarded-For. COM TÚNEL OU PROXY, USE 1: sem isso todos os
#                    clientes (inclusive um atacante e a Meta) parecem um IP só e dividem a mesma cota.
#   10.0.0.0/8,::1   lista de IPs/CIDRs dos proxies confiáveis
#   true             confia em TODA a cadeia: o cliente escolhe o IP que quiser. Só para ambiente
#                    fechado; NUNCA em produção.
TRUST_PROXY=false
