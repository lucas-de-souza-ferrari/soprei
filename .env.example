# Copie para .env (cp .env.example .env) e ajuste. Nunca commite o .env.
# Todas as variáveis são validadas no boot em src/infrastructure/config/.

# Ambiente de execução: development | test | production
NODE_ENV=development

# Endereço e porta em que o servidor HTTP escuta
HOST=0.0.0.0
PORT=3000

# Nível de log do Pino: fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# PostgreSQL nativo (obrigatória). Role "soprei" e banco "soprei": ver "Ambiente local" no CLAUDE.md.
# Troque <senha> pela senha escolhida ao criar o role (com caracteres especiais, use URL-encode).
DATABASE_URL=postgresql://soprei:<senha>@localhost:5432/soprei?schema=public

# Redis nativo (obrigatória). Índice 0 para desenvolvimento; os testes usam o 15 (ver .env.test.example).
REDIS_URL=redis://localhost:6379/0

# Pool de conexões do PostgreSQL (opcionais; os valores abaixo são os defaults)
# Máximo de conexões abertas (1 a 200)
DB_POOL_MAX=10
# Tempo para fechar uma conexão ociosa, em ms (1 a 3600000)
DB_POOL_IDLE_TIMEOUT_MS=30000
# Tempo máximo esperando uma conexão do pool, em ms (1 a 120000)
DB_POOL_CONNECTION_TIMEOUT_MS=5000
# Tempo máximo de uma query no servidor, em ms (1 a 600000)
DB_STATEMENT_TIMEOUT_MS=30000

# Autenticação (spec 007). Substitui a antiga ADMIN_API_KEY, que foi REMOVIDA: se ainda estiver no seu
# .env, deixou de ter efeito (pode apagar). As rotas /admin/* agora exigem um access token (login em
# POST /auth/login ou /auth/platform/login); o primeiro usuário nasce por `pnpm auth:cli` (ver AGENTS.md).
# Segredo do JWT (HS256): OBRIGATÓRIO em todos os ambientes, mínimo 32 caracteres, nunca em log.
# Para gerar: node -e "console.log(require('node:crypto').randomBytes(48).toString('base64url'))"
# Trocar o segredo derruba todos os access tokens (os refresh tokens continuam e geram novos).
# Descomente e preencha (sem valor padrão de propósito: um valor público de exemplo seria um segredo fraco).
# JWT_SECRET=
JWT_ISSUER=soprei
JWT_AUDIENCE=soprei-api
# Validade do access token, em segundos (60 a 3600).
AUTH_ACCESS_TTL_SECONDS=900
# Refresh token: prazo ocioso (renovado a cada rotação; 3600 a 2592000) e teto absoluto da sessão desde o
# login (precisa ser maior ou igual ao ocioso).
AUTH_REFRESH_TTL_SECONDS=604800
AUTH_SESSION_MAX_SECONDS=2592000
# Tolerância de relógio na verificação do access token, em segundos (0 a 60).
AUTH_CLOCK_TOLERANCE_SECONDS=5
# Bloqueio por conta: depois de N falhas de senha em LOCK segundos, novas tentativas respondem 429
# (também para contas que não existem). N de 1 a 20; LOCK de 60 a 86400.
AUTH_LOGIN_MAX_FAILURES=5
AUTH_LOGIN_LOCK_SECONDS=900
# Prazo de cada comando da conexão Redis das sessões, em ms (1 a 10000). Redis fora: as rotas de
# autenticação respondem 503 (fail-closed), nunca aceitam nem emitem token.
AUTH_REDIS_TIMEOUT_MS=500
AUTH_REDIS_PREFIX=soprei:auth:

# Token do endpoint GET /metrics (spec 004), enviado em "Authorization: Bearer <token>".
# Opcional. Sem ele, /metrics NÃO existe (responde 404), para não expor métricas por engano.
# Se informado, precisa ter no mínimo 32 caracteres; vazio vale como ausente.
# Para gerar: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# METRICS_TOKEN=

# Atendimento (spec 010). Todas opcionais; os valores abaixo são os defaults.
# Provedor de LLM por trás da interface LlmProvider: "mock" (determinístico, sem rede; padrão) ou
# "anthropic" (Claude, spec 014). Trocar de modelo é mudar esta variável, não código de negócio.
LLM_PROVIDER=mock
# Só com LLM_PROVIDER=anthropic (spec 014). A chave é um segredo: nunca commite, nunca cole em chat
# nem em log. Crie na Anthropic Console e DEFINA UM LIMITE DE GASTO MENSAL na conta antes de usar.
# ANTHROPIC_API_KEY=<sua-chave-da-anthropic>
# Opcional; https:// em produção. Existe para os testes (servidor falso); vazio usa a API oficial.
# ANTHROPIC_BASE_URL=
# O SDK também lê ANTHROPIC_CUSTOM_HEADERS do ambiente; o provedor o ignora de propósito.
# Modelo (padrão claude-haiku-5-5; formato ^[a-z0-9.-]{1,64}$).
# LLM_MODEL=claude-haiku-5-5
# Esforço de raciocínio: low (padrão), medium ou high. Mais esforço, mais latência e custo.
# LLM_EFFORT=low
# Teto de tokens por resposta (64 a 8192; padrão 1024). Conta também o pensamento adaptivo do modelo:
# com LLM_EFFORT medium ou high, suba o teto; senão a resposta é cortada (max_tokens -> resultado
# truncated) e o contato recebe o texto padrão. Resposta cortada nunca é enviada pela metade.
# LLM_MAX_OUTPUT_TOKENS=1024
# Repetições em 408/409/429/5xx e falha de rede (0 a 3; padrão 1), sempre dentro de LLM_TIMEOUT_MS.
# LLM_MAX_RETRIES=1
# Prazo máximo de uma chamada ao LLM, em ms (1 a 120000). Estourou: o contato recebe o texto padrão de falha.
LLM_TIMEOUT_MS=15000
# Uma mensagem do contato sem resposta há mais que isto (ms, 1 a 3600000) deixa de estar "em andamento":
# a retentativa com o mesmo externalId completa o fluxo em vez de receber 409.
ATTENDANCE_IN_FLIGHT_TIMEOUT_MS=60000

# Rate limiting (spec 005). Todas opcionais; os valores abaixo são os defaults.
# Limites por perfil e por IP, guardados no Redis (valem entre várias instâncias). Estourou: 429.
# Liga/desliga ("true" ou "false" literais). "false" é rejeitado com NODE_ENV=production.
RATE_LIMIT_ENABLED=true
# Cada perfil: máximo de requisições (1 a 1000000) por janela em segundos (1 a 86400).
# public: rede de segurança, vale para toda rota sem perfil declarado
RATE_LIMIT_PUBLIC_MAX=100
RATE_LIMIT_PUBLIC_WINDOW_SECONDS=900
# admin: rotas /admin/*
RATE_LIMIT_ADMIN_MAX=600
RATE_LIMIT_ADMIN_WINDOW_SECONDS=60
# webhook: webhook do canal de mensagens (spec 011). Folgado de propósito: 429 faz a Meta retentar.
RATE_LIMIT_WEBHOOK_MAX=600
RATE_LIMIT_WEBHOOK_WINDOW_SECONDS=60
# login: /auth/login e /auth/platform/login (spec 007). refresh: /auth/refresh e /auth/logout. Esses dois
# perfis são FAIL-CLOSED: com o Redis do limiter fora, respondem 503 em vez de liberar.
RATE_LIMIT_LOGIN_MAX=10
RATE_LIMIT_LOGIN_WINDOW_SECONDS=900
RATE_LIMIT_REFRESH_MAX=60
RATE_LIMIT_REFRESH_WINDOW_SECONDS=900
# Prazo de cada comando Redis do limiter, em ms (1 a 10000). Redis fora ou lento custa no máximo isto
# por requisição, que passa em fail-open (com log de erro e a métrica rate_limit_store_errors_total).
RATE_LIMIT_REDIS_TIMEOUT_MS=250
# De onde vem o IP do cliente (a chave do limite). Padrão false: X-Forwarded-For é IGNORADO.
#   false                ignora X-Forwarded-For (o servidor recebe conexões direto dos clientes)
#   127.0.0.1,::1        lista de IPs/CIDRs dos proxies confiáveis (o peer que abre a conexão com o
#                        servidor). Túnel local (Cloudflare Tunnel, ngrok) na mesma máquina: 127.0.0.1,::1.
#                        nginx em outra máquina: o IP dela, ex.: 10.0.0.5 ou 10.0.0.0/8. O IP do cliente é o
#                        último endereço do X-Forwarded-For que não está na lista.
#   true                 confia em TODA a cadeia: o cliente escolhe o IP que quiser e escapa do limite.
#                        Só para ambiente fechado; NUNCA em produção (a config recusa com NODE_ENV=production).
# Não existe valor inteiro ("1 proxy"): o Fastify não confia em contagem de saltos.
# ANTES de depender de um túnel ou proxy, confirme que ele ACRESCENTA o IP do cliente ao
# X-Forwarded-For (e não repassa o cabeçalho que o cliente mandou): senão o cliente forja o IP.
# COM TÚNEL OU PROXY, configure a lista: sem isso todos os clientes (inclusive um atacante e a Meta)
# parecem um IP só e dividem a mesma cota.
TRUST_PROXY=false

# Canal WhatsApp (spec 011): webhook de entrada, fila e envio da resposta pela Cloud API da Meta.
# Opt-in: sem WHATSAPP_ENABLED=true as rotas GET/POST /webhooks/whatsapp NÃO existem (404).
# "true" ou "false" literais. Com "true", os três segredos abaixo e TRUST_PROXY (acima) são obrigatórios;
# TRUST_PROXY precisa estar DEFINIDO explicitamente (mesmo "false"): atrás de túnel/proxy, liste-o
# (ex.: TRUST_PROXY=127.0.0.1,::1 com Cloudflare Tunnel/ngrok na mesma máquina).
WHATSAPP_ENABLED=false
# Segredo do app Meta (App Dashboard > Configurações > Básico; mínimo de 16 caracteres). Usado só para validar X-Hub-Signature-256.
# WHATSAPP_APP_SECRET=
# Token de verificação do webhook: escolhido por você (mínimo 16 caracteres) e digitado no painel da Meta.
# Usado só no handshake GET. Para gerar: node -e "console.log(require('node:crypto').randomBytes(24).toString('hex'))"
# WHATSAPP_VERIFY_TOKEN=
# Token de envio (mínimo de 16 caracteres; temporário de ~24 h com o número de teste; token permanente de usuário do sistema fora dele).
# WHATSAPP_ACCESS_TOKEN=
# Opcionais; os valores abaixo são os defaults.
# URL base do Graph API (http:// só fora de produção; os testes apontam para um servidor falso local).
WHATSAPP_API_BASE_URL=https://graph.facebook.com
# Versão do Graph API (formato vNN.N). Padrão: a versão estável vigente quando a spec 011 foi implementada.
WHATSAPP_GRAPH_API_VERSION=v26.0
# Prazo de cada envio ao Graph API, em ms (1 a 120000).
WHATSAPP_SEND_TIMEOUT_MS=10000
# Fila de entrada (BullMQ sobre o Redis). Tentativas por job (1 a 20) e atraso inicial do backoff
# exponencial em ms (10 s, 20 s, 40 s, 80 s com os padrões). Com o canal ligado,
# QUEUE_BACKOFF_MS x (2^(QUEUE_ATTEMPTS - 1) - 1) precisa ser maior que ATTENDANCE_IN_FLIGHT_TIMEOUT_MS.
QUEUE_ATTEMPTS=5
QUEUE_BACKOFF_MS=10000
# Retenção MÍNIMA (s) de jobs concluídos e falhos no Redis (o job guarda o texto do contato e o contactRef).
# Não é um TTL: o BullMQ só apaga por idade quando OUTRO job termina e as chaves não expiram sozinhas, então
# sem tráfego o último job (texto e contactRef) pode ficar no Redis indefinidamente. Limpeza periódica ou TTL
# são pendência da spec 011, a resolver com a política de retenção/LGPD antes de dados reais.
QUEUE_KEEP_COMPLETED_SECONDS=3600
QUEUE_KEEP_FAILED_SECONDS=86400
# Agrupamento de mensagens rápidas do canal (spec 013): o sistema espera o contato parar de escrever e
# responde UMA vez às mensagens pendentes. Só valem com o canal habilitado; o simulador /admin não espera.
# Janela deslizante: cada mensagem nova reinicia a espera (0 a 60000 ms; 0 desliga a espera).
# Toda resposta passa a demorar pelo menos a janela, mais o tempo do LLM.
CHANNEL_BATCH_WINDOW_MS=5000
# Teto de espera, contado desde a mais antiga mensagem pendente (0 a 300000 ms; >= a janela).
CHANNEL_BATCH_MAX_WAIT_MS=20000
# Limites de uma resposta: mensagens (1 a 50) e caracteres somados (1 a 24000). O excedente vira o
# turno seguinte, sem nova espera; uma única mensagem maior que o limite de caracteres segue sozinha.
CHANNEL_BATCH_MAX_MESSAGES=10
CHANNEL_BATCH_MAX_CHARS=8000
