// A URL do banco é lida de DATABASE_URL em prisma.config.ts (Prisma 7).
//
// Isolamento entre clientes: todo model é de TENANT (tem `clientId`) ou GLOBAL (sem
// `clientId`) e precisa estar classificado em src/infrastructure/database/extensions/tenant-scope.ts;
// um teste lê este schema e falha se algum model ficar sem classificação.

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ClientStatus {
  ACTIVE
  SUSPENDED

  @@map("client_status")
}

/// Raiz do tenant (GLOBAL: não é filtrado por clientId). Soft delete por `deletedAt`;
/// o slug segue único mesmo depois da remoção (fica reservado).
model Client {
  id                    String       @id @default(uuid(7)) @db.Uuid
  name                  String
  slug                  String       @unique
  status                ClientStatus @default(ACTIVE)
  createdAt             DateTime     @default(now()) @map("created_at")
  updatedAt             DateTime     @updatedAt @map("updated_at")
  deletedAt             DateTime?    @map("deleted_at")
  /// Persona do assistente (até 4000 caracteres; nulo = persona padrão). Nunca vai para log.
  persona               String?
  /// phone_number_id do número do WhatsApp (Cloud API da Meta) deste cliente: 1 a 32 dígitos, único.
  /// Único ponto do sistema que leva de um identificador externo ao cliente (spec 011).
  whatsappPhoneNumberId String?      @unique @map("whatsapp_phone_number_id")

  conversations     Conversation[]
  messages          Message[]
  users             User[]
  auditEvents       AuditEvent[]
  channelConnection ChannelConnection?

  @@map("clients")
}

enum MessageRole {
  USER
  ASSISTANT

  @@map("message_role")
}

/// Conversa de um contato com o assistente de um cliente. `contactRef` é o identificador do
/// contato definido pelo canal (texto livre). (TENANT)
model Conversation {
  id         String   @id @default(uuid(7)) @db.Uuid
  clientId   String   @map("client_id") @db.Uuid
  contactRef String   @map("contact_ref")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  client   Client    @relation(fields: [clientId], references: [id], onDelete: Restrict)
  messages Message[]

  // `[id, clientId]` existe só para as chaves estrangeiras compostas de Message.
  @@unique([id, clientId])
  @@unique([clientId, contactRef])
  @@index([clientId, createdAt, id])
  @@map("conversations")
}

/// Mensagem de uma conversa (do contato ou do assistente). (TENANT)
/// Integridade entre clientes no banco: as chaves estrangeiras são COMPOSTAS com `clientId`,
/// então uma mensagem nunca aponta para conversa nem para outra mensagem de outro cliente.
/// `content` nunca vai para log nem para label de métrica.
model Message {
  id               String      @id @default(uuid(7)) @db.Uuid
  clientId         String      @map("client_id") @db.Uuid
  conversationId   String      @map("conversation_id") @db.Uuid
  role             MessageRole
  content          String
  isFallback       Boolean     @default(false) @map("is_fallback")
  /// Id da mensagem no canal, para idempotência (único por cliente quando presente).
  externalId       String?     @map("external_id")
  /// Na resposta do assistente, a mensagem do contato a que ela responde.
  replyToId        String?     @map("reply_to_id") @db.Uuid
  createdAt        DateTime    @default(now()) @map("created_at")
  /// Id da mensagem enviada no canal (wamid), só em resposta do assistente já enviada.
  channelMessageId String?     @map("channel_message_id")
  /// Quando a resposta foi entregue ao canal; nulo = ainda não enviada (ou o envio falhou).
  sentAt           DateTime?   @map("sent_at")
  /// Na mensagem do CONTATO, a resposta do assistente que a atendeu (agrupamento de mensagens, spec 013).
  /// Várias mensagens do mesmo lote apontam para a mesma resposta. Só mensagem USER tem o campo (CHECK).
  answeredById     String?     @map("answered_by_id") @db.Uuid

  client       Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  conversation Conversation @relation(fields: [conversationId, clientId], references: [id, clientId], onDelete: NoAction)
  replyTo      Message?     @relation("MessageReply", fields: [replyToId, clientId], references: [id, clientId], onDelete: NoAction)
  replies      Message[]    @relation("MessageReply")
  answeredBy   Message?     @relation("MessageAnswer", fields: [answeredById, clientId], references: [id, clientId], onDelete: NoAction)
  answers      Message[]    @relation("MessageAnswer")

  @@unique([id, clientId])
  @@unique([clientId, externalId])
  // No máximo uma resposta por mensagem do contato (a retentativa concorrente não duplica).
  @@unique([clientId, replyToId])
  @@index([clientId, conversationId, createdAt, id])
  @@map("messages")
}

enum UserRole {
  OWNER
  ADMIN
  AGENT
  VIEWER

  @@map("user_role")
}

enum UserStatus {
  ACTIVE
  DISABLED

  @@map("user_status")
}

/// Pessoa de um cliente (TENANT). E-mail normalizado (NFKC, trim, minúsculas), único POR cliente.
/// `passwordHash` (scrypt) nunca vai a log, resposta nem métrica. E-mail também é dado pessoal.
model User {
  id           String     @id @default(uuid(7)) @db.Uuid
  clientId     String     @map("client_id") @db.Uuid
  email        String
  passwordHash String     @map("password_hash")
  role         UserRole   @default(AGENT)
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  client        Client       @relation(fields: [clientId], references: [id], onDelete: Restrict)
  auditAsActor  AuditEvent[] @relation("AuditActor")
  auditAsTarget AuditEvent[] @relation("AuditTarget")

  // `[id, clientId]` existe só para as chaves estrangeiras compostas de AuditEvent (spec 008).
  @@unique([id, clientId])
  @@unique([clientId, email])
  @@index([clientId, createdAt, id])
  @@map("users")
}

enum AuditAction {
  USER_CREATED
  USER_ROLE_CHANGED
  USER_DISABLED
  USER_ENABLED
  USER_PASSWORD_RESET
  USER_PASSWORD_CHANGED
  CHANNEL_CONNECTED
  CHANNEL_TOKEN_REPLACED
  CHANNEL_DISCONNECTED

  @@map("audit_action")
}

/// Trilha de auditoria imutável (TENANT, spec 008). Sem texto livre, sem e-mail, sem IP: só ids e
/// valores de enum. As chaves estrangeiras são COMPOSTAS com `clientId`: um evento nunca aponta para
/// usuário de outro cliente. A API não atualiza nem apaga eventos; usuário nunca é apagado (Restrict).
model AuditEvent {
  id           String      @id @default(uuid(7)) @db.Uuid
  clientId     String      @map("client_id") @db.Uuid
  action       AuditAction
  actorUserId  String      @map("actor_user_id") @db.Uuid
  /// Nulo nas ações CHANNEL_* (spec 015); CHECK no banco: USER_* exige alvo, CHANNEL_* exige nulo.
  targetUserId String?     @map("target_user_id") @db.Uuid
  fromRole     UserRole?   @map("from_role")
  toRole       UserRole?   @map("to_role")
  createdAt    DateTime    @default(now()) @map("created_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)
  actor  User   @relation("AuditActor", fields: [actorUserId, clientId], references: [id, clientId], onDelete: Restrict)
  target User?  @relation("AuditTarget", fields: [targetUserId, clientId], references: [id, clientId], onDelete: Restrict)

  @@index([clientId, createdAt, id])
  @@map("audit_events")
}

/// Operador da plataforma (GLOBAL: não pertence a cliente algum). E-mail único global.
model PlatformAdmin {
  id           String     @id @default(uuid(7)) @db.Uuid
  email        String     @unique
  passwordHash String     @map("password_hash")
  status       UserStatus @default(ACTIVE)
  createdAt    DateTime   @default(now()) @map("created_at")
  updatedAt    DateTime   @updatedAt @map("updated_at")

  @@map("platform_admins")
}

enum ChannelConnectionStatus {
  CONNECTED
  TOKEN_INVALID

  @@map("channel_connection_status")
}

/// Credencial do canal WhatsApp de um cliente (TENANT, spec 015): no máximo uma por cliente. O token
/// fica CIFRADO (AES-256-GCM, AAD ligada ao clientId); nunca em claro no banco, em log, resposta nem
/// métrica. O número continua só em `Client.whatsappPhoneNumberId`.
model ChannelConnection {
  id              String                  @id @default(uuid(7)) @db.Uuid
  clientId        String                  @unique @map("client_id") @db.Uuid
  wabaId          String                  @map("waba_id")
  tokenCiphertext String                  @map("token_ciphertext")
  tokenVersion    Int                     @default(1) @map("token_version")
  status          ChannelConnectionStatus @default(CONNECTED)
  tokenExpiresAt  DateTime?               @map("token_expires_at")
  tokenInvalidAt  DateTime?               @map("token_invalid_at")
  createdAt       DateTime                @default(now()) @map("created_at")
  updatedAt       DateTime                @updatedAt @map("updated_at")

  client Client @relation(fields: [clientId], references: [id], onDelete: Restrict)

  @@map("channel_connections")
}
