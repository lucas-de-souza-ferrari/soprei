{
  "name": "soprei-workspace",
  "private": true,
  "packageManager": "pnpm@12.3.4",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm --filter soprei-backend dev",
    "dev:frontend": "pnpm --filter soprei-frontend dev",
    "build": "pnpm --filter soprei-backend build && pnpm --filter soprei-frontend build",
    "start": "pnpm --filter soprei-backend start",
    "test": "pnpm --filter soprei-backend test && pnpm --filter soprei-frontend test",
    "test:integration": "pnpm --filter soprei-backend test:integration",
    "typecheck": "pnpm --filter soprei-backend typecheck && pnpm --filter soprei-frontend typecheck",
    "lint": "pnpm --filter soprei-backend lint && pnpm --filter soprei-frontend lint",
    "format": "pnpm --filter soprei-backend exec prettier --write .. --ignore-path ../.prettierignore",
    "format:check": "pnpm --filter soprei-backend exec prettier --check .. --ignore-path ../.prettierignore",
    "db:generate": "pnpm --filter soprei-backend db:generate",
    "db:migrate": "pnpm --filter soprei-backend db:migrate",
    "db:migrate:deploy": "pnpm --filter soprei-backend db:migrate:deploy",
    "auth:cli": "pnpm --filter soprei-backend auth:cli"
  }
}
